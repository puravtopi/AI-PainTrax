@model PainTrax.Web.Models.tbl_intake_forward_setting
<main id="main" class="main">

    <div class="pagetitle">
        <h1>Manage Forward Setting for Intake Sheet</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Group">Settings</a></li>
                <li class="breadcrumb-item active">Intake Sheet</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">

                        @*<h5 class="card-title">Add Designation</h5>*@
                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <h5 class="card-title">Forward Setting</h5>
                            </div>
                            <div class="col-sm-12 col-md-6" style="text-align:right;padding-top:5px;">
                            </div>
                        </div>

                        <!-- General Form Elements -->
                        <form asp-action="IntakeSetting" asp-controller="Settings" id="frmCreate">
                            <div class="row">
                                <div class="col-lg-12">
                                    <input type="hidden" asp-for="Id" />

                                    <!-- History Row -->
                                    <div class="row mb-3">
                                        <label asp-for="History" class="col-md-4 col-lg-3 col-form-label">History</label>
                                        <div class="col-md-8 col-lg-9">
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="History" class="form-check-input" id="historyYes" value="true">
                                                <label class="form-check-label" for="historyYes">Yes</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="History" class="form-check-input" id="historyNo" value="false">
                                                <label class="form-check-label" for="historyNo">No</label>
                                            </div>
                                            <span asp-validation-for="History" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label asp-for="Cc" class="col-md-4 col-lg-3 col-form-label">Present Complaint</label>
                                        <div class="col-md-8 col-lg-9">
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Cc" class="form-check-input" id="historyYes" value="true">
                                                <label class="form-check-label" for="historyYes">Yes</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Cc" class="form-check-input" id="historyNo" value="false">
                                                <label class="form-check-label" for="historyNo">No</label>
                                            </div>
                                            <span asp-validation-for="Cc" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label asp-for="Pe" class="col-md-4 col-lg-3 col-form-label">Physical Examination</label>
                                        <div class="col-md-8 col-lg-9">
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Pe" class="form-check-input" id="historyYes" value="true">
                                                <label class="form-check-label" for="historyYes">Yes</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Pe" class="form-check-input" id="historyNo" value="false">
                                                <label class="form-check-label" for="historyNo">No</label>
                                            </div>
                                            <span asp-validation-for="Pe" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <label asp-for="Diagnosis" class="col-md-4 col-lg-3 col-form-label">Diagnoses</label>
                                        <div class="col-md-8 col-lg-9">
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Diagnosis" class="form-check-input" id="historyYes" value="true">
                                                <label class="form-check-label" for="historyYes">Yes</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Diagnosis" class="form-check-input" id="historyNo" value="false">
                                                <label class="form-check-label" for="historyNo">No</label>
                                            </div>
                                            <span asp-validation-for="Diagnosis" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label asp-for="Neroexam" class="col-md-4 col-lg-3 col-form-label">Neuro Exam</label>
                                        <div class="col-md-8 col-lg-9">
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Neroexam" class="form-check-input" id="historyYes" value="true">
                                                <label class="form-check-label" for="historyYes">Yes</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Neroexam" class="form-check-input" id="historyNo" value="false">
                                                <label class="form-check-label" for="historyNo">No</label>
                                            </div>
                                            <span asp-validation-for="Neroexam" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label asp-for="Adl" class="col-md-4 col-lg-3 col-form-label">ADL</label>
                                        <div class="col-md-8 col-lg-9">
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Adl" class="form-check-input" id="historyYes" value="true">
                                                <label class="form-check-label" for="historyYes">Yes</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Adl" class="form-check-input" id="historyNo" value="false">
                                                <label class="form-check-label" for="historyNo">No</label>
                                            </div>
                                            <span asp-validation-for="Adl" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label asp-for="Note" class="col-md-4 col-lg-3 col-form-label">Dr Ford Notes</label>
                                        <div class="col-md-8 col-lg-9">
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Note" class="form-check-input" id="historyYes" value="true">
                                                <label class="form-check-label" for="historyYes">Yes</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input type="radio" asp-for="Note" class="form-check-input" id="historyNo" value="false">
                                                <label class="form-check-label" for="historyNo">No</label>
                                            </div>
                                            <span asp-validation-for="Note" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="row mb-3">

                                        <div class="col-sm-10">
                                            <button type="submit" class="btn btn-primary">Save</button>
                                            <a class="btn btn-primary" asp-action="IntakeSetting" asp-controller="Settings">Back</a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </section>

</main><!-- End #main -->