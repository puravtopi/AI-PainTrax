<div id="neckSection" style="display:none;">
    <h6 class="fw-bold">Neck</h6>
    <div class="select-group">
        Pain:
        <input id="NeckPain" class="form-control d-inline" style="width:30px" />
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'NeckPain')"></i>/10

        <label><input type="checkbox" class="chkMulti" name="NeckStiffness" value="Stiffness"> <span class="select-btn">Stiffness</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckStiffness" value="Diff turning"> <span class="select-btn">Diff turning</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckStiffness" value="rotating head"> <span class="select-btn">rotating head</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckStiffness" value="Diff gripping hand"> <span class="select-btn">Diff gripping hand</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckStiffness" value="sustained improvement with PT"> <span class="select-btn">sustained improvement with PT</span></label>


    </div>
    <div class="select-group">
        Neck pain radiates to
        <label><input type="radio" name="NeckRadiatesTo" value="Left"> <span class="select-btn">L</span></label>
        <label><input type="radio" name="NeckRadiatesTo" value="Right"> <span class="select-btn">R</span></label>
        <label><input type="radio" name="NeckRadiatesTo" value="Bilateral"> <span class="select-btn">B</span></label>


        <label><input type="checkbox" class="chkMulti" name="NeckRadiates" value="shoulder"> <span class="select-btn">shoulder</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckRadiates" value="elbow"> <span class="select-btn">elbow</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckRadiates" value="arm"> <span class="select-btn">arm</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckRadiates" value="hand"> <span class="select-btn">hand</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckRadiates" value="fingers"> <span class="select-btn">fingers. </span></label>
    </div>
    <div class="select-group">
        Neck pain is associated with
        <label><input type="checkbox" class="chkMulti" name="NeckAssociated" value="tingling"> <span class="select-btn">tingling</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckAssociated" value="numbness"> <span class="select-btn">numbness</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckAssociated" value="weakness"> <span class="select-btn">weakness</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckAssociated" value="burning"> <span class="select-btn">burning</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckAssociated" value="spasms"> <span class="select-btn">spasms</span></label>
    </div>
    <div class="select-group">
        Neck pain worsened with
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="sitting"> <span class="select-btn">sitting</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="standing"> <span class="select-btn">standing</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="lying down"> <span class="select-btn">lying down</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value=" movement activities">  <span class="select-btn">movement activities</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="going from seating to standing up"> <span class="select-btn">going from seating to standing up</span></label>
    </div>
    <div class="select-group">
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="walking"> <span class="select-btn">walking</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="climbing stairs">  <span class="select-btn">climbing stairs</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="descending stairs"> <span class="select-btn">descending stairs</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="driving"> <span class="select-btn">driving</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="working"> <span class="select-btn">working</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="bending"> <span class="select-btn">bending</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="lifting"> <span class="select-btn">lifting</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckWorsens" value="twisting"> <span class="select-btn">twisting</span></label>
    </div>
    <div class="select-group">
        Neck pain improved with
        <label><input type="checkbox" class="chkMulti" name="NeckImproves" value="Resting"> <span class="select-btn">Resting</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckImproves" value="Medication"> <span class="select-btn">Medication</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckImproves" value="Therapy"> <span class="select-btn">Therapy</span></label>
        <label><input type="checkbox" class="chkMulti" name="NeckImproves" value="Sleeping"> <span class="select-btn">Sleeping</span></label>
        @* <label><input type="checkbox" class="chkMulti" name="NeckImproves" value="Others"> Others</label>
                                                    <input id="NeckImprovesOther" class="form-control d-inline " style="width:300px" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'NeckImprovesOther')"></i> *@
    </div>

</div>
