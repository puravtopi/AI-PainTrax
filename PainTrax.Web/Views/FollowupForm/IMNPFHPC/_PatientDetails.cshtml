
<input type="hidden" id="FN" name="FN" />
<input type="hidden" id="LN" name="LN" />
<input type="hidden" id="PatientId" name="PatientId" />
<input type="hidden" id="PatientIEId" name="PatientIEId" />

<style>
    .is-invalid {
        border: 2px solid red !important;
    }
</style>


<h6>Provider Name:  @ViewBag.ProviderName</h6>
<!-- Patient Info -->
<div class="select-group">

    Patient Name:
    <input id="PatientName" name="PatientName" class="form-control d-inline" style="width:250px;" />
    Gender
    <select id="Gender" name="Gender" class="form-select d-inline w-auto" style="width:50px !important">
        <option value="male">M</option>
        <option value="female">F</option>
    </select>
    &nbsp;&nbsp;
    handed:
    <select id="DominantHand" name="DominantHand" class="form-select d-inline w-auto" style="width:50px !important">
        <option value="right-handed">R</option>
        <option value="left-handed">L</option>
    </select>
    &nbsp;&nbsp;

    @*  DOA
                                                <input id="DOA" name="DOA" type="date" class="form-control d-inline w-auto" />
                                                &nbsp;&nbsp; *@
    Location:
    @* <span id="lblLocation">
                                                    @ViewBag.LocName
                                                </span> *@
    <select id="LocationId" name="LocationId" asp-items="@ViewBag.locList" class="form-select d-inline w-auto" style="width:230px !important">
    </select>
    <div id="patientGrid"
         class="table-responsive border bg-white position-absolute shadow"
         style="width:500px; z-index:999; display:none; max-height:250px; overflow:auto;">

        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Patient Name</th>
                    <th>DOB</th>
                    <th>DOA</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


<div class="select-group">
    DOE
    <input id="DOE" name="DOE" type="date" class="form-control d-inline" style="width:125px" oninput="validateYear(this)" />
    &nbsp;&nbsp;
    DOB:
    <input id="DOB" name="DOB" type="date" class="form-control d-inline" style="width:125px" oninput="formatDOB(this)" onblur="validateDOB(this)" required />
    &nbsp;&nbsp;&nbsp;
    Age:
    <input id="Age" name="Age" class="form-control d-inline" style="width:30px" /> years
    &nbsp;&nbsp;&nbsp;

    DOA:
    <input id="DOA" name="DOA" type="date" class="form-control d-inline" style="width:125px" oninput="validateYear(this)" />
    &nbsp;&nbsp;
    <label>Case Type:</label>
    <label>
        <input type="radio" name="InjuryType" value="NF">
        <span class="select-btn">NF</span>
    </label>

    <label>
        <input type="radio" name="InjuryType" value="WC">
        <span class="select-btn">WC</span>
    </label>

    <label>
        <input type="radio" name="InjuryType" value="MM">
        <span class="select-btn">MM</span>
    </label>

    <label>
        <input type="radio" name="InjuryType" value="PI">
        <span class="select-btn">PI</span>
    </label>
    <label>
        <input type="radio" name="InjuryType" value="LIEN">
        <span class="select-btn">LIEN</span>
    </label>


</div>

<div class="select-group">

    Degree of Disability <input id="degree" class="form-control d-inline" style="width:250px" /> %.
    &nbsp;&nbsp;&nbsp;&nbsp;
    Working:
    <label><input type="radio" name="IsWorking" value="The patient is currently working"> <span class="select-btn">Yes</span></label>
    <label><input type="radio" name="IsWorking" value="The patient stopped working immediately after accident."> <span class="select-btn">No</span></label>
    <span id="divWorking" style="display:none">
        &nbsp;&nbsp;
        <input type="radio" name="YesWork" id="PartTime" value="Part time"> <span class="select-btn">Part-time</span>
        <input type="radio" name="YesWork" id="FullTime" value="Full time">  <span class="select-btn">Full-time</span>
    </span>


</div>

<div class="select-group">
    Chief complaint:

    <div class="select-group">

        The patient presents today with
        <label><input type="radio" name="PatientPresent" value="ongoing pain "> <span class="select-btn">ongoing pain </span></label>
        <label><input type="radio" name="PatientPresent" value="evaluation of neck "> <span class="select-btn">evaluation of neck </span></label>
        <label><input type="radio" name="PatientPresent" value="midback"> <span class="select-btn">midback </span></label>
        <label><input type="radio" name="PatientPresent" value="lowback"> <span class="select-btn">lowback </span></label>

        @*   <input id="Occupation" name="Occupation" class="form-control d-inline w-auto" style="min-width:90%;" />
    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'Occupation')"></i> *@
    </div>
    <p>
        S/p:  injection
        <input id="Injection" name="Injection" class="form-control d-inline" style="width:350px;" />
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'Injection')"></i>
        on
        <input id="InjectionOn" name="InjectionOn" class="form-control d-inline" style="width:200px" />
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'InjectionOn')"></i>
        with
        <input id="InjectionWith" name="InjectionWith" class="form-control d-inline" style="width:200px" /> % improvement.
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'InjectionWith')"></i>
    </p>
    <p>
        surgery
        <input id="Surgery" name="Surgery" class="form-control d-inline" style="width:350px" />
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'Surgery')"></i>
        on
        <input id="SurgeryOn" name="SurgeryOn" class="form-control d-inline" style="width:200px" />
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'SurgeryOn')"></i>
        with
        <input id="SurgeryWith" name="SurgeryWith" class="form-control d-inline" style="width:200px" /> % improvement.
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'SurgeryWith')"></i>
    </p>
    <p>
        <label><input type="checkbox" class="chkMulti" name="Complaints" value="Neck" data-section="neckSection" data-pe="neckPE" /> <span class="select-btn">Neck</span></label>
        <label><input type="checkbox" class="chkMulti" name="Complaints" value="Midback" data-section="midbackSection" data-pe="mbPE" /> <span class="select-btn">Mid back</span></label>
        <label><input type="checkbox" class="chkMulti" name="Complaints" value="Lowback" data-section="lbSection" data-pe="lbPE" /> <span class="select-btn">Low back</span></label>

        <input type="text" id="OtherBodyPart" name="OtherBodyPart" class="form-control d-inline w-auto" placeholder="other" />
    </p>
</div>
<script>
    $("#PatientName").on("keyup", function () {

        let search = $(this).val();
         var url = '@Url.Action("SearchPatient", "FollowupForm")';

        if (search.length < 2) {
            $("#patientGrid").hide();
            return;
        }

        $.ajax({
            url: url,
            type: 'GET',
            data: { term: search },
            success: function (data) {

                let rows = "";
                debugger

                $.each(data, function (i, item) {

                        rows += `
        <tr class="patient-row"
            data-id="${item.id}"
            data-intakeid="${item.intakeid}"
            data-patientid="${item.patient_id}"
            data-name="${item.lname} ${item.fname}">

            <td>${item.lname} ${item.fname}</td>

            <td>
                ${
                    item.dob
                        ? new Date(item.dob).toLocaleDateString('en-US', {
                              month: '2-digit',
                              day: '2-digit',
                              year: 'numeric'
                          })
                        : ''
                }
            </td>
             <td>
                ${
                    item.doa
                        ? new Date(item.doa).toLocaleDateString('en-US', {
                              month: '2-digit',
                              day: '2-digit',
                              year: 'numeric'
                          })
                        : ''
                }
            </td>
        </tr>
    `;
                });

                $("#patientGrid tbody").html(rows);

                if (data.length > 0)
                    $("#patientGrid").show();
                else
                    $("#patientGrid").hide();
            }
        });

    });

    // Row Select Event
    $(document).on("click", ".patient-row", function () {

        let patientName = $(this).data("name");
        let patientId = $(this).data("patientid");
        let patientIEId = $(this).data("id");
        let patientIntakeId = $(this).data("intakeid");

        $("#PatientName").val(patientName);
        $("#PatientIEId").val(patientIEId);
        $("#PatientId").val(patientId);

        console.log("Selected Patient Intake ID:", patientIntakeId);

        $("#patientGrid").hide();

        let url="@Url.Action("GetIntakeData", "FollowupForm")?id="+patientId;

        $.ajax({
            url: url,
            type: 'GET',
            success: function (res) {
                debugger
                console.log("Result: "+res);
                bindForm(res);
            }
        });
    });

    // Hide grid when click outside
    $(document).click(function (e) {
        if (!$(e.target).closest('#PatientName, #patientGrid').length) {
            $("#patientGrid").hide();
        }
    });
</script>
