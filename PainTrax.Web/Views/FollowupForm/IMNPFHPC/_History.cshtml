

    <div class="select-group">
        PMH:
        <label><input type="checkbox" class="chkMulti" name="PMH" value="None"> <span class="select-btn">None</span></label>
        <label><input type="checkbox" class="chkMulti" name="PMH" value="Diabetes"> <span class="select-btn">Diabetes</span></label>
        <label><input type="checkbox" class="chkMulti" name="PMH" value="HBP"> <span class="select-btn">HBP</span></label>
        <label><input type="checkbox" class="chkMulti" name="PMH" value="HLD"><span class="select-btn"> HLD</span></label>
        <label><input type="checkbox" class="chkMulti" name="PMH" value="Asthma"> <span class="select-btn">Asthma</span></label>
        <label><input type="checkbox" class="chkMulti" name="PMH" value="Cardiac disease"> <span class="select-btn">Cardiac disease</span></label>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        Other:
        <input id="PMHOther" class="form-control d-inline w-25" style="min-width:37%" />
        <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'PMHOther')"></i>
    </div>
    <p>
        PSH:
        <input id="PSH" class="form-control d-inline w-50" placeholder="None or details" style="min-width:80%" />
        <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'PSH')"></i>
    </p>
    <p>
        Previous Procedures:
        <input id="PProcedures" class="form-control d-inline w-50" placeholder="None or details" style="min-width:80%" />
        <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'PProcedures')"></i>
    </p>
    <p>
        Meds:

        <input id="MedsOther" class="form-control d-inline w-25" />
        <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'MedsOther')"></i>
    </p>
    <!-- Allergies -->
    <div class="select-group">
        Allergies:
        <label><input type="radio" name="Allergy" value="No"> <span class="select-btn">No</span></label>
        <label><input type="radio" name="Allergy" value="Yes"> <span class="select-btn">Yes</span></label>
        <span id="divAllergy" style="display:none">
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            What Allergy:
            <input id="AllergyReaction" class="form-control d-inline w-25" />
            <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'AllergyReaction')"></i>
        </span>
    </div>
    <div class="select-group">
        Smoker:
        <label><input type="radio" name="Smoke" value="Yes"> <span class="select-btn">Y</span></label>
        <label><input type="radio" name="Smoke" value="No" checked><span class="select-btn"> N</span></label>
        <span id="divSmoke" style="display:none">
            <input id="PPD" class="form-control d-inline" style="width:150px" /> PPD.
            <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'PPD')"></i>
        </span>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        Alcohol:
        <label><input type="radio" name="Alcohol" value="The patient drinks alcohol occasionally."><span class="select-btn"> Y</span></label>
        <label><input type="radio" name="Alcohol" value="The patient does not drink alcohol." checked><span class="select-btn"> N</span></label>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        @* Cannabis:
                                                <label><input type="radio" name="Cannabis" value="The patient smokes cannabis."><span class="select-btn"> Y</span></label>
                                                <label><input type="radio" name="Cannabis" value="The patient does not smoke cannabis."><span class="select-btn"> N</span></label>
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; *@
        Drugs:
        <label><input type="radio" name="OtherDrugs" value="Yes"><span class="select-btn"> Y</span></label>
        <label><input type="radio" name="OtherDrugs" value="No" checked><span class="select-btn"> N</span></label>
        <span id="divDrugs" style="display:none">
            <input type="text" id="OtherDrugsTxt" name="OtherDrugsTxt" placeholder="Other Drugs Name" class="form-control d-inline w-auto" />
            <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'OtherDrugsTxt')"></i>
        </span>
    </div>
    <div class="select-group">
        Physical therapy:
        <label><input type="radio" name="PT" value="Yes"> <span class="select-btn">Y</span></label>
        <label><input type="radio" name="PT" value="The patient has not had physical therapy."> <span class="select-btn">N</span></label>
        <span id="divPT" style="display:none">
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            If yes, how often:
            <input id="PTFreq" class="form-control d-inline w-25" style="min-width:37%" placeholder="x/week" />
            <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'PTFreq')"></i>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            @*  x a week: *@
        </span>
    </div>
    <div class="select-group">
        Chiropractor:
        <label><input type="radio" name="Chiro" value="Yes"> <span class="select-btn">Y</span></label>
        <label><input type="radio" name="Chiro" value="No"> <span class="select-btn">N</span></label>
        <span id="divChiro" style="display:none">
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            If yes, how often?
            <input id="ChiroFreq" class="form-control d-inline w-25" style="min-width:37%" placeholder="x/week" />
            <i class="fa fa-microphone d-inline  mic-btn mic-hide" onclick="startVoice(this,'ChiroFreq')"></i>
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            @*  x a week. *@
        </span>
    </div>
