<link href="~/assets/img/favicon.png" rel="icon">
<link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

@{
    Layout = "~/Views/Shared/_IntakeLayout.cshtml";  // Use the admin layout
}
<link href="~/assets/css/intakesheet.css" rel="stylesheet" />
<main id="main" class="main" style="margin-left:0px!important">

    <section class="section">
        <div class="col-lg-12">

            <div class="row">
                <!-- LEFT: FORM -->
                <div class="col-md-12 col-12" id="formSection" name="formSection">
                    <button id="openPreview"
                            class="btn btn-sm btn-outline-primary mt-3"
                            style="display:none;">
                        Show Preview
                    </button>
                    <button id="uploadDL"
                            class="btn btn-sm btn-outline-primary mt-3" onclick="fnshowPatientList()">
                        Select Patient
                    </button>
                    <form method="post" id="patientForm" name="patientForm" class="container my-4">
                        <input type="hidden" id="hdId" name="hdId" value="@ViewBag.Id" />
                        <input type="hidden" id="PatientSubmitDate" name="PatientSubmitDate" value="@ViewBag.SubmitDate" />
                        <input type="hidden" id="LocationId" name="LocationId" value="@ViewBag.LocId" />
                        <input type="hidden" id="DLPath" name="DLPath" />
                        <input type="hidden" id="hdIEId" name="hdIEId" />
                        <input type="hidden" id="hdSelectedBody" name="hdSelectedBody" />
                        <input type="hidden" id="Diagnosis" name="Diagnosis" />
                        <input type="hidden" id="TreatmentIds" name="TreatmentIds" />
                        <input type="hidden" id="TreatmentDesc" name="TreatmentDesc" />
                        <input type="hidden" id="TreatmentDelimitDesc" name="TreatmentDelimitDesc" />
                        <h4 class="text-center mb-4 fw-bold">
                            Patient Injury Report
                        </h4>

                        <div class="border p-4 rounded shadow-sm" style="line-height: 2; font-size: 15px;background-color:white">
                            <b><i>*Note: Please do not use single quot(') in any fields.</i></b>

                            <div class="accordion" id="accordionExample">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                            Patient Details
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <br />
                                            <!-- Patient Info -->
                                            <p>
                                                Patient LName:
                                                <input id="LN" name="LN" class="form-control d-inline" style="width:150px;" />
                                                FName:
                                                <input id="FN" name="FN" class="form-control d-inline" style="width:150px;" />
                                                @*  <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PatientName')"></i> *@
                                                Gender
                                                <select id="Gender" name="Gender" class="form-select d-inline w-auto" style="width:50px !important">
                                                    <option value="male">M</option>
                                                    <option value="female">F</option>
                                                </select>
                                                &nbsp;&nbsp;
                                                handed:
                                                <select id="DominantHand" name="DominantHand" class="form-select d-inline w-auto" style="width:50px !important">
                                                    <option value="right-handed">R</option>
                                                    <option value="left-handed">L</option>
                                                    <option value="ambidextrous">A</option>
                                                </select>
                                                &nbsp;&nbsp;
                                                DOE
                                                <input id="DOE" name="DOE" type="date" class="form-control d-inline w-auto" />
                                                &nbsp;&nbsp;
                                                Location: &nbsp;&nbsp;
                                                <span id="lblLocation">
                                                    @ViewBag.LocName
                                                </span>
                                            </p>

                                            <p>
                                                DOB:
                                                <input id="DOB" name="DOB" type="date" class="form-control d-inline w-auto" />
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                Age:
                                                <input id="Age" name="Age" class="form-control d-inline" style="width:50px" /> years
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;

                                                DOA:
                                                <input id="DOA" name="DOA" type="date" class="form-control d-inline w-auto" />
                                            </p>

                                            <p>
                                                <strong>Case Type:</strong>

                                                @*  <label><input type="radio" class="chkMulti" name="CaseType" value="NF"> NF</label>

                                                    <label><input type="radio" class="chkMulti" name="CaseType" value="WC"> WC</label>

                                                    <label><input type="radio" class="chkMulti" name="CaseType" value="MM"> MM</label>

                                                    <label><input type="radio" class="chkMulti" name="CaseType" value="LIEN"> LIEN</label>

                                                    <label><input type="radio" class="chkMulti" name="CaseType" value="PI"> PI</label> *@
                                                <div class="select-group">
                                                    <label>
                                                        <input type="radio" name="CaseType" value="NF">
                                                        <span class="select-btn">NF</span>
                                                    </label>

                                                    <label>
                                                        <input type="radio" name="CaseType" value="WC">
                                                        <span class="select-btn">WC</span>
                                                    </label>

                                                    <label>
                                                        <input type="radio" name="CaseType" value="MM">
                                                        <span class="select-btn">MM</span>
                                                    </label>

                                                    <label>
                                                        <input type="radio" name="CaseType" value="PI">
                                                        <span class="select-btn">PI</span>
                                                    </label>
                                                </div>
                                            </p>

                                            <p>
                                                <b>VITAL SIGNS:</b>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Height:
                                                <input id="Height" name="Height" class="form-control d-inline" onchange="calculateBMI()" style="width:150px" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'Height')"></i>
                                                Weight:
                                                <input id="Weight" name="Weight" class="form-control d-inline" onchange="calculateBMI()" style="width:150px" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'Weight')"></i>
                                                lbs,
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;SpO2:
                                                <input id="SpO" name="SpO" class="form-control d-inline" style="width:100px" />%,
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;HR:
                                                <input id="HR" name="HR" class="form-control d-inline" style="width:100px" />,
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;BMI:
                                                <input id="BMI" name="BMI" class="form-control d-inline" style="width:100px" />
                                            </p>

                                            <!-- Work -->
                                            <p>
                                                Currently working:
                                                <input type="radio" name="IsWorking" value="The patient is currently working." /> Yes
                                                <input type="radio" name="IsWorking" value="The patient stopped working immediately after accident." /> No
                                                <br />


                                                Degree of Disability:

                                                <input id="DisabilityPercentage"
                                                       class="form-control d-inline"
                                                       style="width:100px"
                                                       type="number"
                                                       min="0"
                                                       max="100" />

                                                % temporarily disabled
                                            </p>
                                            <div id="divWC1" style="display:none;">
                                                <p>
                                                    Occupation:
                                                    <input id="Occupation" name="Occupation" class="form-control d-inline w-auto" style="min-width:90%;" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'Occupation')"></i>
                                                    <br />
                                                    Job Description:
                                                    <input id="JobTitle" name="JobTitle" class="form-control d-inline w-auto" style="min-width:95%;" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'JobTitle')"></i>
                                                </p>
                                                <p>
                                                    Sit <input id="SitHr" class="form-control d-inline" style="width:80px" /> hr.

                                                    Drive <input id="DriveHr" class="form-control d-inline" style="width:80px" /> hr.

                                                    Stand <input id="StandHr" class="form-control d-inline" style="width:80px" /> hr.

                                                    Walk <input id="WalkHr" class="form-control d-inline" style="width:80px" /> hr.

                                                    Kneel/Stoop <input id="KneelHr" class="form-control d-inline" style="width:80px" /> hr.

                                                    Reach Overhead <input id="ReachOverhead" class="form-control d-inline" style="width:80px" />

                                                    Reach Below Waist <input id="ReachBelowWaist" class="form-control d-inline" style="width:80px" />
                                                </p>
                                                <p>
                                                    On your job how many hours a day do you spend:

                                                    Sitting <input id="JobSitting" class="form-control d-inline" style="width:80px" /> hr.

                                                    Standing <input id="JobStanding" class="form-control d-inline" style="width:80px" /> hr.

                                                    Driving <input id="JobDriving" class="form-control d-inline" style="width:80px" /> hr.

                                                    Bending <input id="JobBending" class="form-control d-inline" style="width:80px" /> hr.

                                                    Kneeling <input id="JobKneeling" class="form-control d-inline" style="width:80px" /> hr.

                                                    Crouching <input id="JobCrouching" class="form-control d-inline" style="width:80px" /> hr.

                                                    Lifting <input id="JobLifting" class="form-control d-inline" style="width:80px" /> hr.
                                                </p>

                                                <p>
                                                    If lifting, how many pounds:
                                                    <div class="select-group">
                                                        <label><input type="checkbox" class="chkMulti" name="LiftingWeight" value="5">     <span class="select-btn">5</span></label>

                                                        <label><input type="checkbox" class="chkMulti" name="LiftingWeight" value="10">     <span class="select-btn">10</span></label>

                                                        <label><input type="checkbox" class="chkMulti" name="LiftingWeight" value="10-20">     <span class="select-btn">10-20</span></label>

                                                        <label><input type="checkbox" class="chkMulti" name="LiftingWeight" value="greater than 20"> <span class="select-btn">Greater than 20</span></label>
                                                    </div>
                                                </p>
                                                @* <p>
                                                If not working, stopped immediately after accident:
                                                <input type="radio" name="StoppedAfterAccident" value="Yes" /> Yes
                                                <input type="radio" name="StoppedAfterAccident" value="No" /> No
                                                <br />
                                                Reason:
                                                <textarea id="NotWorkingReason" name="NotWorkingReason" class="form-control d-inline w-50" style="min-width:90%;"></textarea>
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'NotWorkingReason')"></i>
                                            </p> *@
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingTwo">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                            History
                                        </button>
                                    </h2>
                                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <!-- Chief Complaint -->
                                            <p>
                                                <b> Chief complaint:</b>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Neck" data-section="neckSection" data-pe="neckPE" /> Neck</label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Midback" data-section="mbSection" data-pe="mbPE" /> Mid back</label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Lowback" data-section="lbSection" data-pe="lbPE" /> Low back</label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Shoulder" data-section="rshSection" data-pe="rshPE" /> R/SH</label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Shoulder" data-section="lshSection" data-pe="lshPE" /> L/SH</label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Knee" data-section="rknSection" data-pe="rknPE" /> R/KN</label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Knee" data-section="lknSection" data-pe="lknPE" /> L/KN</label>
                                                <input type="text" id="OtherBodyPart" name="OtherBodyPart" class="form-control d-inline w-auto" placeholder="other" />
                                            </p>

                                            <!-- Injury Type -->
                                            @* <p>
                                                Type of Injury:
                                                <label><input type="radio" name="InjuryType" value="motor vehicle" /> MVA</label>
                                                <label><input type="radio" name="InjuryType" value="work-related" /> Work-related</label>
                                                <label><input type="radio" name="InjuryType" value="mm" /> MM</label>
                                                <label><input type="radio" name="InjuryType" value="lien" /> Lien</label>
                                                <label><input type="radio" name="InjuryType" value="pi" /> PI</label>
                                            </p> *@

                                            <div id="divNF" style="display:none;">
                                                <!-- Paragraph Description -->
                                                <p>

                                                <p>
                                                    Patient reports being:
                                                    <label><input type="checkbox" class="chkMulti" name="PatientType" value="Bicyclist"> Bicyclist</label>
                                                    <label><input type="checkbox" class="chkMulti" name="PatientType" value="Pedestrian"> Pedestrian</label>
                                                    <label><input type="checkbox" class="chkMulti" name="PatientType" value="Belted Driver"> Belted Driver</label>
                                                    <label><input type="checkbox" class="chkMulti" name="PatientType" value="Front Passenger">Front Passenger</label>
                                                    <label><input type="checkbox" class="chkMulti" name="PatientType" value="Right Side Back Passenger"> Right Side Back Passenger</label>
                                                    <label><input type="checkbox" class="chkMulti" name="PatientType" value="Left Side Back Passenger">Left Side Back Passenger</label>
                                                    <label><input type="checkbox" class="chkMulti" name="PatientType" value="Bus passenger"> Bus passenger</label>
                                                </p>
                                                <p>
                                                    Vehicle hit:
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Rear-end"> Rear-end</label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Front-end"> Front-end</label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Driver side front"> Driver-side front</label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Driver-side rear"> Driver-side rear</label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Passenger-side front">Passenger-side front</label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Passenger side rear"> Passenger-side rear </label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Driver sideswipe">Driver sideswipe</label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Driver side T-boned"> Driver side T-boned  </label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Passenger-side T-boned"> Passenger-side T-boned   </label>
                                                    <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Passenger sideswipe"> Passenger sideswipe</label>
                                                </p>
                                                <p>
                                                    Please describe
                                                    <textarea id="MMDescription" name="MMDescription" class="form-control d-inline" style="width:95%"></textarea>
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'MMDescription')"></i>
                                                </p>



                                            </div>
                                            <div id="divWC" style="display:none;">
                                                <!-- Paragraph Description -->
                                                <p>
                                                    The patient states
                                                    <input type="date" id="lblDOA" name="lblDOA" style="display:none" />
                                                    <input type="text" id="States" name="States" class="form-control d-inline w-auto" />
                                                    <label><input type="checkbox" class="chkMulti" name="StatesType" value="slip and fall"> slip and fall </label>
                                                    <label><input type="checkbox" class="chkMulti" name="StatesType" value="motor vehicle accident  "> motor vehicle accident </label>
                                                    <label><input type="checkbox" class="chkMulti" name="StatesType" value="occupational disease "> occupational disease</label>
                                                    <label><input type="checkbox" class="chkMulti" name="StatesType" value="others"> others</label>
                                                    <input type="text" id="StatesOther" name="StatesOther" class="form-control d-inline w-auto" />
                                                </p>


                                            </div>
                                            <div class="accident-impact-section">

                                                <p>
                                                    <strong>At the time of the accident, did you have direct impact on any body part?</strong>

                                                    <label>
                                                        <input type="radio" name="DirectImpact" value="Yes"> Yes
                                                    </label>

                                                    <label>
                                                        <input type="radio" name="DirectImpact" value="No"> No
                                                    </label>
                                                </p>

                                                <p>
                                                    <strong>If yes, which body part?</strong>

                                                    <textarea id="DirectImpactBodyPart"
                                                              class="form-control"
                                                              rows="2"></textarea>
                                                </p>

                                                <p>
                                                    <strong>Did you lose consciousness?</strong>

                                                    <label>
                                                        <input type="radio" name="LoseConsciousness" value="Yes"> Yes
                                                    </label>

                                                    <label>
                                                        <input type="radio" name="LoseConsciousness" value="No"> No
                                                    </label>

                                                    &nbsp;&nbsp;&nbsp;

                                                    <strong>If yes, then for how long?</strong>

                                                    <input id="LOCForHowLong"
                                                           class="form-control d-inline"
                                                           style="width:250px" />
                                                </p>

                                            </div>
                                            <p>
                                                EMS arrived:
                                                <label><input type="radio" name="EMS" value="Yes"> Yes</label>
                                                <label><input type="radio" name="EMS" value="No"> No</label>
                                            </p>
                                            <p>
                                                Went to hospital?
                                                <label><input type="radio" name="Hospital" value="Yes"> Yes</label>
                                                <label><input type="radio" name="Hospital" value="No"> No</label>
                                                <div id="divHospital" style="display:none">

                                                    Hospital name:
                                                    <input id="HospitalName" class="form-control d-inline w-25" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'HospitalName')"></i>
                                                    @*  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                        Records:
                                                        <label><input type="radio" name="Records" value="Yes"> Yes</label>
                                                        <label><input type="radio" name="Records" value="No"> No</label>
                                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; *@
                                                    How did you get to hospital:
                                                    <label><input type="radio" name="Transport" value="Ambulance"> Ambulance</label>
                                                    <label><input type="radio" name="Transport" value="Car"> Car</label>
                                                    <label><input type="radio" name="Transport" value="Uber"> Uber</label>
                                                    <label><input type="radio" name="Transport" value="Cab"> Cab</label>
                                                    <label><input type="radio" name="Transport" value="Friend"> Friend</label>
                                                </div>
                                            </p>
                                            <p>
                                                Did you go on the same day?
                                                <label><input type="radio" name="SameDay" value="Yes"> Yes</label>
                                                <label><input type="radio" name="SameDay" value="No"> No</label>

                                                how many days later?
                                                <input id="DaysLater" name="DaysLater" class="form-control d-inline w-25" />

                                            </p>
                                            <p>
                                                In the hospital, Did they do any tests?
                                                <label><input type="radio" name="IsHospitalTest" value="Yes"> Yes</label>
                                                <label><input type="radio" name="IsHospitalTest" value="No"> No</label>
                                                If yes, what tests?
                                                <label><input type="checkbox" class="chkMulti" name="HospitalTest" value="X-rays"> X-rays </label>
                                                <label><input type="checkbox" class="chkMulti" name="HospitalTest" value="CT"> CT </label>
                                                <label><input type="checkbox" class="chkMulti" name="HospitalTest" value="MRI"> MRI </label>
                                                <input type="text" id="HospitalTestOther" name="HospitalTestOther" class="form-control d-inline w-auto" />
                                            </p>
                                            <p>
                                                Were you prescribed any medication?
                                                <label><input type="radio" name="IsHospitalMedication" value="Yes"> Yes</label>
                                                <label><input type="radio" name="IsHospitalMedication" value="No"> No</label>
                                                If yes, what medication?
                                                <input type="text" id="HospitalMedication" name="HospitalMedication" class="form-control d-inline w-auto" />
                                            </p>
                                            <p>
                                                Have you been involved in an accident in the past?
                                                <label><input type="radio" name="IsAccidentPast" value="Yes"> Yes</label>
                                                <label><input type="radio" name="IsAccidentPast" value="No"> No</label>
                                                If yes, when?
                                                <input type="text" id="AccidentPast" name="AccidentPast" class="form-control d-inline w-auto" />
                                                Body parts injured in that accident
                                                <input type="text" id="AccidentBodyPart" name="AccidentBodyPart" class="form-control d-inline w-auto" />
                                                Did you completely recover?
                                                <label><input type="radio" name="IsAccidentRecover" value="Yes"> Yes</label>
                                                <label><input type="radio" name="IsAccidentRecover" value="No"> No</label>
                                            </p>

                                            <!-- PMH -->
                                            <p>
                                                Any Medication conditions?:
                                                <label><input type="radio" name="IsPMH" value="Yes"> Yes</label>
                                                <label><input type="radio" name="IsPMH" value="No"> No</label>
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="Diabetes"> Diabetes</label>
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="High BP"> High BP</label>
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="Asthma"> Asthma</label>
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="Heart disease"> Heart disease</label>
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="Pregnant"> Pregnant</label>
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="Seizure History"> Seizure History</label>
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="Bleeding Problems/Bruise easily/Blood clotting Issues"> Bleeding Problems/Bruise easily/Blood clotting Issues</label>
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="Immune Deficiency"> Immune Deficiency</label>
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                Other:
                                                <input id="PMHOther" class="form-control d-inline w-25" style="min-width:37%" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PMHOther')"></i>
                                            </p>

                                            <!-- PSH -->
                                            <p>
                                                Have you ever had any surgeries?
                                                <label><input type="radio" name="IsSMH" value="Yes"> Yes</label>
                                                <label><input type="radio" name="IsSMH" value="No"> No</label>
                                                <input id="PSH" class="form-control d-inline w-50" placeholder="None or details" style="min-width:80%" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PSH')"></i>
                                            </p>

                                            <!-- Meds -->
                                            <p>
                                                Are you taking any medications?
                                                <label><input type="radio" name="Meds" value="Yes"> Yes</label>
                                                <label><input type="radio" name="Meds" value="No"> No</label>

                                                <input id="MedsOther" class="form-control d-inline w-25" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'MedsOther')"></i>
                                            </p>
                                            <!-- Allergies -->
                                            <p>
                                                Drug Allergies:
                                                <label><input type="radio" name="Allergy" value="No"> No</label>
                                                <label><input type="radio" name="Allergy" value="Yes"> Yes</label>
                                                <span id="divAllergy" style="display:none">
                                                    @*  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                        Drug:
                                                        <input id="AllergyDrug" class="form-control d-inline w-25" />
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'AllergyDrug')"></i> *@
                                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                    What Allergy:
                                                    <input id="AllergyReaction" class="form-control d-inline w-25" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'AllergyReaction')"></i>
                                                </span>
                                            </p>

                                            <!-- Social History -->
                                            <p style="display:none">
                                                Smoke:
                                                <label><input type="radio" name="Smoke" value="Yes"> Y</label>
                                                <label><input type="radio" name="Smoke" value="No"> N</label>
