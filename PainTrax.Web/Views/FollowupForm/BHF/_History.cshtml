<!-- Chief Complaint -->
<div class="select-group">
    <b> Chief complaint:</b>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Neck" data-section="neckSection" data-pe="neckPE" />  <span class="select-btn">Neck</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Midback" data-section="mbSection" data-pe="mbPE" /> <span class="select-btn">Mid back</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Lowback" data-section="lbSection" data-pe="lbPE" />  <span class="select-btn">Low back</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Shoulder" data-section="rshSection" data-pe="rshPE" />  <span class="select-btn">R/SH</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Shoulder" data-section="lshSection" data-pe="lshPE" />  <span class="select-btn">L/SH</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Knee" data-section="rknSection" data-pe="rknPE" /> <span class="select-btn">R/KN</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Knee" data-section="lknSection" data-pe="lknPE" />  <span class="select-btn">L/KN</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Ankle" data-section="rankleSection" data-pe="ranklePE" /> <span class="select-btn">R/Ank</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Ankle" data-section="lankleSection" data-pe="lanklePE" />  <span class="select-btn">L/Ank</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Elbow" data-section="relbowSection" data-pe="relbowPE" /> <span class="select-btn">R/El</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Elbow" data-section="lelbowSection" data-pe="lelbowPE" />  <span class="select-btn">L/El</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Hip" data-section="rhipSection" data-pe="rhipPE" /> <span class="select-btn">R/Hip</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Hip" data-section="lfipSection" data-pe="lhipPE" />  <span class="select-btn">L/Hip</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Wrist" data-section="rwristSection" data-pe="rwristPE" /> <span class="select-btn">R/Wrist</span></label>
    <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Wrist" data-section="lwristSection" data-pe="lwristPE" />  <span class="select-btn">L/Wrist</span></label>
    <input type="text" id="OtherBodyPart" name="OtherBodyPart" class="form-control d-inline w-auto" placeholder="other" />
</div>
<div class="select-group">
    <label><input type="radio" name="FUType" value="Post injection FU" /> <span class="select-btn">Post Injection FU</span></label>
    <label><input type="radio" name="FUType" value="Normal FU" /> <span class="select-btn"> Normal FU</span></label>
</div>
<div id="divInjectionFU" style="display:none">
    <div class="select-group">
        <b> Post injection FU :</b>
        <br />
        <p>
            The patient is status post
            <input type="text" id="StatusPost" name="StatusPost" class="form-control d-inline w-auto" />
        </p>
        <p>
            Patient reported
            <input type="text" id="Reported" name="Reported" class="form-control d-inline " style="width:70px" /> %
            symptoms improvement that lasted a period of
            <input type="text" id="SymptomsImprov" name="SymptomsImprov" class="form-control d-inline" style="width:200px" />
        </p>
        <p>
            During that
            <input type="text" id="During" name="During" class="form-control d-inline" style="width:150px" />
            period patient reported: Radicular symptoms had improved by greater than
            <input type="text" id="RadicularSys" name="RadicularSys" class="form-control d-inline" style="width:70px" />%
        </p>
    </div>
    <div class="select-group">
        <label><input type="checkbox" class="chkMulti" name="PostInjection" value="VAS pain scores had improved by greater than 50%." />  <span class="select-btn"> VAS pain scores had improved by greater than 50%.</span></label>
        <label><input type="checkbox" class="chkMulti" name="PostInjection" value="There was functional improvement in ROM." />  <span class="select-btn">  There was functional improvement in ROM.</span></label>
        <label><input type="checkbox" class="chkMulti" name="PostInjection" value="Patient required less use of assistive devices." />  <span class="select-btn">  Patient required less use of assistive devices.</span></label>
        <label><input type="checkbox" class="chkMulti" name="PostInjection" value="Patient reported better sleep pattern." />  <span class="select-btn">  Patient reported better sleep pattern.</span></label>
        <label><input type="checkbox" class="chkMulti" name="PostInjection" value="Patient reported decreased use of analgesics both in frequency and dosage." />  <span class="select-btn">   Patient reported decreased use of analgesics both in frequency and dosage.</span></label>
        <label><input type="checkbox" class="chkMulti" name="PostInjection" value="Patient reported improvements in Activities of Daily Living (ADL)." />  <span class="select-btn"> Patient reported improvements in Activities of Daily Living (ADL).</span></label>
        <label><input type="checkbox" class="chkMulti" name="PostInjection" value="Patient reported increased tolerance to walking, standing, and sitting." />  <span class="select-btn">Patient reported increased tolerance to walking, standing, and sitting.</span></label>

    </div>
    <div class="select-group">
        <span>Patient symptoms:</span>
        <label><input type="radio" name="InjectionSymptomsBaseline" value="have" /> <span class="select-btn">have</span></label>
        <label><input type="radio" name="InjectionSymptomsBaseline" value="have not" /> <span class="select-btn">have not</span></label>
        <span>returned to baseline.</span>
    </div>
    <div class="select-group">
        Patient is doing
        <label><input type="radio" class="chkMulti" name="PostInjection" value="PT" />  <span class="select-btn">PT</span></label>
        <label><input type="radio" class="chkMulti" name="PostInjection" value="Chiro" />  <span class="select-btn">Chiro</span></label>
        <label><input type="radio" class="chkMulti" name="PostInjection" value="Acupuncture" />  <span class="select-btn">Acupuncture </span></label>
        <input type="text" id="PatientDoing" name="PatientDoing" class="form-control d-inline" style="width:70px" /> x a week.
    </div>
    <p>
        <textarea id="PostInjectionOther" name="PostInjectionOther" class="form-control d-inline" style="width:95%"></textarea>
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PostInjectionOther')"></i>
    </p>
</div>
<div id="divNormalFU" style="display:none">
    <div class="select-group">
        <b> Normal FU :</b>
        <br />
        <p>
            The patient is status post
            <input type="text" id="StatusPostNormal" name="StatusPostNormal" class="form-control d-inline w-auto" />
        </p>
        <p>
            Patient reports
            <input type="text" id="SymptomPercent" name="SymptomPercent" class="form-control d-inline " style="width:70px" /> %
            symptom improvement for
            <input type="text" id="SymptomImprovementFor" name="SymptomImprovementFor" class="form-control d-inline" style="width:250px" />
        </p>
    </div>

    <div class="select-group">
        <span>Patient symptoms:</span>
        <label><input type="radio" name="SymptomsBaseline" value="have" /> <span class="select-btn">have</span></label>
        <label><input type="radio" name="SymptomsBaseline" value="have not" /> <span class="select-btn">have not</span></label>
        <span>returned to baseline.</span>
    </div>
    <div class="select-group">
        <span>Patient reports radicular symptoms:</span>
        <label><input type="radio" name="RadicularStatus" value="improved" /> <span class="select-btn">improved</span></label>
        <label><input type="radio" name="RadicularStatus" value="unchanged" /> <span class="select-btn">unchanged</span></label>
    </div>

    <div class="select-group">
        <label><input type="checkbox" class="chkMulti" name="NormalFUCheck" value="The patient reports decreased usage of analgesic both in frequency and dosage." />  <span class="select-btn"> Patient reports decreased usage of analgesic both in frequency and dosage.</span></label>
        <label><input type="checkbox" class="chkMulti" name="NormalFUCheck" value="The patient reports functional improvement in his/her ROM." />  <span class="select-btn">  Patient reports functional improvement in ROM.</span></label>
        <label><input type="checkbox" class="chkMulti" name="NormalFUCheck" value="The patient reports better sleep pattern and duration." />  <span class="select-btn">  Patient reports better sleep pattern and duration.</span></label>
    </div>

    <div class="select-group">
        The patient is doing
        <label><input type="radio" name="TherapyType" value="PT" />  <span class="select-btn">PT</span></label>
        <label><input type="radio" name="TherapyType" value="Chiro" />  <span class="select-btn">Chiro</span></label>
        <label><input type="radio" name="TherapyType" value="Acupuncture" />  <span class="select-btn">Acupuncture </span></label>
        <input type="text" id="TherapyFreq" name="TherapyFreq" class="form-control d-inline" style="width:70px" /> x/week.
    </div>

    <p>
        <textarea id="NormalFUOther" name="NormalFUOther" class="form-control d-inline" style="width:95%"></textarea>
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'NormalFUOther')"></i>
    </p>
</div>
<script>
        $('input[name="FUType"]').on('change', function() {
        if ($(this).val() === 'Post injection FU') {
            $('#divInjectionFU').show();
            $('#divNormalFU').hide();
        } else {
            $('#divNormalFU').show();
            $('#divInjectionFU').hide();
        }
    });
</script>