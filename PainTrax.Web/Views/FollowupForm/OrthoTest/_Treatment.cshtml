                @* <label><input type="checkbox" class="chkMulti" name="TreatmentPlanC" value="Plan Non-surgical"><span class="select-btn"> Plan Non-surgical</span></label>

                                                    <label><input type="checkbox" class="chkMulti" name="TreatmentPlanC" value="Plan Surgical"> <span class="select-btn">Plan Surgical</span></label> *@

                <label><input type="checkbox" class="chkMulti" name="SurgicalArea" value="R/SH"><span class="select-btn"> R/SH</span></label>

                <label><input type="checkbox" class="chkMulti" name="SurgicalArea" value="L/SH"><span class="select-btn"> L/SH</span></label>

