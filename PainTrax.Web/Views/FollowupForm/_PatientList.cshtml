
<div class="table-responsive">
    <table id="tbl" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
        <thead>
            <tr>
                <th scope="col"></th>
                <th scope="col">FName</th>
                <th scope="col">LName</th>
                <th scope="col">DOB</th>
                <th scope="col">DOA</th>
                <th scope="col">Account No</th>
                <th scope="col">DOS</th>
                <th scope="col">Case Type</th>
                <th scope="col">Location</th>
                <th scope="col">Provider</th>
                <th>Action</th>
            </tr>
        </thead>

    </table>
</div>
<script src="//ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {
           bindList();
    });

    function bindList() {

            var url = '@Url.Action("List", "FollowupForm")';
            var editurl = '@Url.Action("Create", "Visit")';
           

            var tab = $("#tbl").DataTable({


                initComplete: function () {

                    $("#tbl_filter").append(`
                                            <span class="ms-2">
                                                <select id="statusFilter"
                                                        class="form-control form-control-sm"
                                                        style="width:120px; display:inline-block;">
                                                    <option value="All">All</option>
                                                    <option value="Active" selected>Active</option>
                                                    <option value="Inactive">Inactive</option>
                                                </select>
                                            </span>
                                        `);

                    var otherFiltersHtml = `
                                        <div class="dt-custom-filters mt-2">

                                            <div class="d-flex flex-wrap align-items-center gap-3">

                                                

                                                <!-- From -->
                                                <div class="d-flex align-items-center gap-2">
                                                    <label class="mb-0 fw-normal">From</label>
                                                    <input type="date" id="fDate" class="form-control form-control-sm" style="width:150px;" />
                                                </div>

                                                <!-- To -->
                                                <div class="d-flex align-items-center gap-2">
                                                    <label class="mb-0 fw-normal">To</label>
                                                    <input type="date" id="tDate" class="form-control form-control-sm" style="width:150px;" />
                                                </div>

                                                <!-- Apply -->
                                                <button id="btnApplyDate" class="btn btn-sm btn-primary">
                                                    Apply
                                                </button>

                                            </div>

                                        </div>
                                        `;

                    $("#tbl_filter").closest(".row").after(otherFiltersHtml);


                    // Filter DataTable when dropdown changes
                    $('#statusFilter').on('change', function () {
                        var val = $(this).val();
                        $('#tbl').DataTable().column(3).search(val).draw();  // Column index to filter
                    });

                    // Location filter
                    $('#locationFilter').on('change', function () {
                        $('#tbl').DataTable().ajax.reload();
                    });
                    $('#btnApplyDate').on('click', function () {

                        var fDate = $('#fDate').val();
                        var tDate = $('#tDate').val();

                        // Optional validation
                        if (fDate && tDate && fDate > tDate) {
                            alert('From Date cannot be greater than To Date');
                            return;
                        }

                        $('#tbl').DataTable().ajax.reload();
                    });
                },

                "lengthMenu": [[25, 50, 100], [25, 50, 100]],
                "pageLength": 10,
                "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": true, // this is for disable filter (search box)
                "orderMulti": false, // for disable multiple column at once
                "ajax": {
                    "url": url,
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.f = $("#hfilter").val();
                        d.statusFilter = $('#statusFilter').val();
                        d.locid = $('#locationFilter').val();
                        // NEW
                        d.fDate = $('#fDate').val();
                        d.tDate = $('#tDate').val();// <-- passes dropdown value correctly
                    }
                },

                "columns": [

                    //{
                    //    "className": 'dt-control',

                    //    "data": null,
                    //    "defaultContent": '➕',
                    //    "visible":"isfu"
                    //},
                    {
                        "className": 'dt-control',


                        "data": "isFU",
                        "defaultContent": '',
                        "render": function (value) {
                            console.log("+" + value)
                            if (value == true)
                                return "➕";
                            else
                                return "";
                        }
                    },
                    {
                        "render": function (data, type, full, meta) {
                            return '<a  href="' + editurl + '/' + full.id + '" id="fname_' + full.patient_id + '">' + full.fname + '</a>';
                        }
                    },
                    //{ "data": "lname", "lname": "lname", "autoWidth": true },
                    {
                        "render": function (data, type, full, meta) {
                            return '<a  href="' + editurl + '/' + full.id + '"  id="lname_' + full.patient_id + '">' + full.lname + '</a>';
                        }
                    },
                    {
                        "data": "dob", "autoWidth": true,
                        "type": "date ",
                        "render": function (value) {

                            if (value === null) return "";

                            var date = new Date(value);
                            var month = date.getMonth() + 1;
                            var formattedDate = date.getDate().toString().length > 1 ? date.getDate() : "0" + date.getDate();
                            return (month.toString().length > 1 ? month : "0" + month) + "/" + formattedDate + "/" + date.getFullYear();
                        }
                    },


                    {
                        "data": "doa", "autoWidth": true,
                        "type": "date ",
                        "render": function (value) {

                            if (value === null) return "";

                            var date = new Date(value);
                            var month = date.getMonth() + 1;
                            var formattedDate = date.getDate().toString().length > 1 ? date.getDate() : "0" + date.getDate();
                            return (month.toString().length > 1 ? month : "0" + month) + "/" + formattedDate + "/" + date.getFullYear();
                        }
                    },
                    { "data": "account_no", "autoWidth": true },
                    {
                        "data": "doe", "autoWidth": true,
                        "type": "date ",
                        "render": function (value) {

                            if (value === null) return "";

                            var date = new Date(value);
                            var month = date.getMonth() + 1;
                            var formattedDate = date.getDate().toString().length > 1 ? date.getDate() : "0" + date.getDate();
                            return (month.toString().length > 1 ? month : "0" + month) + "/" + formattedDate + "/" + date.getFullYear();
                        }
                    },

                    { "data": "compensation", "autoWidth": true },
                    { "data": "location", "location": "location", "autoWidth": true },
                    { "data": "providerName", "providerName": "providerName", "autoWidth": true },
                    {
                        "render": function (data, type, full, meta) {
                            
                            var index = '<a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></a>';
                            index += ' <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">';
                            index += ' <li><a class="dropdown-item d-flex align-items-center" onclick="fnShowComment(' + full.id + ')" href="#" ><i class="bi bi-chat-right-text-fill" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Add Comments" data-bs-original-title="Add Comments"></i><span>Add Comments</span></a></li>';
                            index += ' <li><a class="dropdown-item d-flex align-items-center" onclick="DownloadPdf(' + full.patient_id + ',' + '\'' + `${full.fname.replace(/'/g, "\\'")}` + '\',' + '\'' + `${full.lname.replace(/'/g, "\\'")}` + '\')" href="#"  ><i class=" ri-file-download-fill" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Print Demo" data-bs-original-title="Print Demo "></i><span> Print Demo</span></a></li></ul></a>';

                            return index;
                        }
                    }


                ]

            });
            tab.on('click', 'td.dt-control', function (e) {
                let tr = e.target.closest('tr');
                let row = tab.row(tr);
                e.target.innerHTML = "➕";
                if (row.child.isShown()) {
                    // This row is already open - close it
                    row.child.hide();
                }
                else {
                    // Open this row
                    row.child(fnGetFUList(row.data())).show();
                    e.target.innerHTML = "➖";
                }
            });
        }
</script>