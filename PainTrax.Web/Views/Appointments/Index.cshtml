                //             patientName: "Amit Shah",
                //             status: "Pending",
                //             count: 0

                //         }

                //     ]);
                // }

                // if (viewName === "month") {

                //     scheduler.setOptions({
                //         eventTemplate: $("#monthTemplate").html()
                //     });

                //     // 👉 Simulate aggregated data (count per day)
                //     scheduler.dataSource.data([
                //         {
                //             id: 3,
                //             title: "5",
                //             start: new Date(),
                //             end: new Date(),
                //             providerId: 292,
                //             patientName: "",
                //             count: 5
                //         },
                //         {
                //             id: 4,
                //             title: "3",
                //             start: new Date(new Date().setDate(new Date().getDate() + 1)),
                //             end: new Date(new Date().setDate(new Date().getDate() + 1)),
                //             providerId: 281,
                //             patientName: "",
                //             count: 3
                //         }
                //     ]);
                // }
            }

        $(document).ready(function () {

           var providerData = @Html.Raw(Json.Serialize(ViewBag.provList));
             
            

            $("#provider_id").kendoMultiSelect({
                dataTextField: "text",
                dataValueField: "value",
                dataSource: providerData,
                placeholder: "Select providers...",
                change: providerChange
            });
            var savedLocation = sessionStorage.getItem("locationId");
            if (savedLocation) {
                $("#location_id").val(savedLocation);
            }

            // ✅ restore providers
            var savedProviders = JSON.parse(sessionStorage.getItem("providers") || "[]");
            if (savedProviders.length > 0) {
                var multiSelect = $("#provider_id").data("kendoMultiSelect");
                multiSelect.value(savedProviders.map(x => x.value));
                providerChange();
            }
            else {
                $("#scheduler").hide();
                $("#noProviderMsg").show();
            }
            
