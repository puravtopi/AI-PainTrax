                                providerId: providerId,
                                date: kendo.toString(startTime, "yyyy-MM-dd"),
                                time: kendo.toString(startTime, "HH:mm"),
                                locationId : locationId
                            }, function () {

                                var modal = new bootstrap.Modal(document.getElementById('appointmentModal'));
                                modal.show();
                            });
                            // you can call API / open custom modal here
                        },

                        edit: function (e) {

                            e.preventDefault(); // ❌ stop default update popup/save

                            var startTime = e.event.start;
                            var endTime = e.event.end;
                            var providerId = e.event.providerId;

                            // var id = e.event.id;
