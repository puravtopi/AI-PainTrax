                    var locationId = $("#location_id").val();
                    sessionStorage.setItem("locationId", locationId);
                    initKendo();
             }
             function providerChange() {
                var multiSelect = $("#provider_id").data("kendoMultiSelect");
                var selectedItems = multiSelect.dataItems();

                // ✅ store providers
                sessionStorage.setItem("providers", JSON.stringify(selectedItems));

                initKendo();
                
            }

         function initKendo()
            {
                var locationId = sessionStorage.getItem("locationId");
                var providers = JSON.parse(sessionStorage.getItem("providers") || "[]");
                var savedView = sessionStorage.getItem("schedulerView") || "month";
                var savedDate = sessionStorage.getItem("schedulerDate");

                var currentDate = savedDate ? new Date(savedDate) : new Date();

                // ❌ validation
                if (!locationId || locationId === "0" || providers.length === 0) {
                    $("#scheduler").hide();
                    $("#noProviderMsg").show();
                    return;
                }
                    var selectedProviders = providers.map(item => ({
                        text: item.text,
                        value: Number(item.value)
                }));

                var scheduler = $("#scheduler").data("kendoScheduler");

                if (scheduler) {
                    scheduler.destroy();
                    $("#scheduler").empty();
                }

                 var dayTemplate = kendo.template($("#dayTemplate").html());
                var monthTemplate = kendo.template($("#monthTemplate").html());

                $("#scheduler").kendoScheduler({

                        date: new Date(),

                        views: [
                            {
                                type: "day",
                                allDaySlot: false,
                                 selected: true,

                            },
                            {
                                type: "month"

                            }
                        ],

                      eventTemplate: savedView === "month" ? monthTemplate : dayTemplate,

                        
                        editable: {
                            resize: false,
                            create: true,   
                            update: true,  
                            destroy: false ,
                            move:false
                        },

                        resources: [{
                            field: "providerId",
                            title: "name",
                            dataSource: selectedProviders
                        }],

                        group: {
                            resources: ["providerId"],
                            orientation: "horizontal"
                        },

                        add: function (e) {

                            e.preventDefault();

                                var startTime = e.event.start;
                                var endTime = e.event.end;
                                var providerId = e.event.providerId; // resource field

                            // var fullDateTime = kendo.toString(startTime, "dd/MM/yyyy hh:mm tt");

                            // console.log("DateTime:", fullDateTime);
                            // console.log("Provider:", providerId);

                            // alert(
                            //     "Provider: " + providerId +
