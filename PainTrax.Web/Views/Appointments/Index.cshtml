<script id="dayTemplate" type="text/x-kendo-template">
     <span class="badge
        # if(status == 'Schedule') { # bg-success
        # } else if(status == 'Reschedule') { # bg-warning text-dark
        # } else if(status == 'Cancelled') { # bg-danger
        # } else if(status == 'Completed') { # bg-primary
        # } else { # bg-secondary # } #"

        style="cursor:pointer;"
        onclick="onStatusClick('#= id #', '#= status_id #')">

        #= status #
    </span>
    <span class="badge rounded-pill bg-info text-dark"
        onclick="onMoveClick('#= id #',  '#= start #' )"
        style="cursor:pointer;">
        Move
    </span>
    <div style="cursor:pointer;padding:2px 10px">
        <strong>#= title #</strong>
    </div>

   
</script>

<script id="monthTemplate" type="text/x-kendo-template">
    <div style="text-align:center;">
