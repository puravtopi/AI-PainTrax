    function onMoveClick(id,start) {
        var dt = new Date(start);

          // format date & time
          var app_date = kendo.toString(dt, "yyyy-MM-dd");
          var app_time = kendo.toString(dt, "HH:mm");
          debugger
          $("#appointmentModalContent").load("/Appointments/Move", {
                appid: id,
                app_date :app_date,
                app_time :app_time
          }, function () {
               var modal = new bootstrap.Modal(document.getElementById('appointmentModal'));
                 modal.show();
          });
        }
       function onStatusClick(id, statusId) {
           debugger
        $("#appointmentModalContent").load("/Appointments/ChangeStatus", {
                appid: id,
                statusid: statusId
        }, function () {
               var modal = new bootstrap.Modal(document.getElementById('appointmentModal'));
                 modal.show();
        });
        
