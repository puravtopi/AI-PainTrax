                        dataSource: {
                            data: [],
                            schema: {
                                model: {
                                    id: "id",
                                    fields: {
                                        id: { type: "number" },
                                        title: { type: "string" },
                                        start: { type: "date" },
                                        end: { type: "date" },
                                        providerId: { type: "number" },
                                        status: { type: "string" },
                                        count: { type: "number" }
                                    }
                                }
                            }
                        },

                        

                        dataBound: function () {
                            setShortDayNames(); 
                             
                        },
                        startTime: new Date(2026, 0, 1, 8, 0, 0),   // 8:00 AM
                        endTime: new Date(2026, 0, 1, 20, 30, 0),    // 6:00 PM

                        // ✅ 30 MINUTE SLOT
                        majorTick: 30,   // 1 hour label
                        minorTickCount: 1, // divide into 2 parts → 30 min each

                        showWorkHours: false,

                        navigate: function (e) {
                            sessionStorage.setItem("schedulerView", e.view);
                            sessionStorage.setItem("schedulerDate", e.date.toISOString());
                            loadDataByView(e.view);
                        }

                           

                });

                setTimeout(function () {
                var scheduler = $("#scheduler").data("kendoScheduler");
                    if (scheduler && scheduler.view()) {
                        scheduler.view(savedView);
                         scheduler.date(currentDate);
                        loadDataByView(scheduler.view().name);
                    }
                }, 100);

                // ✅ PROVIDER SELECTED
                $("#noProviderMsg").hide();
                $("#scheduler").show();

            }

             function setShortDayNames() {
                var shortDays = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];
                $(".k-scheduler-monthview tr:eq(2) th").each(function (index) {
                    $(this).text(shortDays[index % 7]);
                });
            }


            function loadDataByView(viewName) {

                var scheduler = $("#scheduler").data("kendoScheduler");

                var location_id = $("#location_id").val();
                var cmp_id = 13;

                var multiSelect = $("#provider_id").data("kendoMultiSelect");
                var selectedItems = multiSelect.dataItems();

                var provider_ids = selectedItems.map(x => x.value).join(",");

                var storedDate = sessionStorage.getItem("schedulerDate");

                var selectedDate;

                if (storedDate) {
                    let d = new Date(storedDate);
                    selectedDate =
                        d.getFullYear().toString() +
                        String(d.getMonth() + 1).padStart(2, '0') +
                        String(d.getDate()).padStart(2, '0');
                } else {
                    selectedDate = kendo.toString(scheduler.date(), "yyyyMMdd");
                }

                console.log("View:", viewName);
                console.log("Date:", selectedDate);
                  scheduler.setOptions({
                        eventTemplate: $("#dayTemplate").html()
                    });
                    scheduler.setOptions({
                        eventTemplate: $("#monthTemplate").html()
                    });


                if (viewName === "day") {

                    scheduler.setOptions({
                        eventTemplate: $("#dayTemplate").html()
                    });

                    $.get("/Appointments/GetAppointmentsDay", {
                        selected_date: selectedDate,
                        cmp_id: cmp_id,
                        location_id: location_id,
                        provider_ids: provider_ids
                    }, function (data) {

                        var parsed = JSON.parse(data);
                        console.log(data);
                        // convert string date → JS Date
                        parsed.forEach(e => {
                            e.start = new Date(e.start);
                            e.end = new Date(e.end);
                        });

                        scheduler.dataSource.data(parsed);
                    });
                }

                if (viewName === "month") {

                    scheduler.setOptions({
                        eventTemplate: $("#monthTemplate").html()
                    });

                    $.get("/Appointments/GetAppointmentsMonth", {
                        cmp_id: cmp_id,
                        location_id: location_id,
                        provider_ids: provider_ids
                    }, function (data) {
                        console.log(data);
                        var parsed = JSON.parse(data);

                        parsed.forEach(e => {
                            e.start = new Date(e.start);
                            e.end = new Date(e.end);
                        });

                        scheduler.dataSource.data(parsed);
                    });
                }
                // if (viewName === "day") {

                //     scheduler.setOptions({
                //         eventTemplate: $("#dayTemplate").html()
                //     });

                //     scheduler.dataSource.data([
                //         {
