@model PainTrax.Web.Models.tbl_diagcodes_group

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Manage Diagnosis Group</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="DiagnoCodeGroup">List</a></li>
                <li class="breadcrumb-item active">Create</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">

                        @*<h5 class="card-title">Add Designation</h5>*@
                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <h5 class="card-title">Add Diagnosis Group</h5>
                            </div>
                            <div class="col-sm-12 col-md-6" style="text-align:right;padding-top:5px;">
                            </div>
                        </div>

                        <!-- General Form Elements -->
                        <form asp-action="Edit" asp-controller="DiagnoCodeGroup">
                            <input type="hidden" asp-for="Id" />
                            <div class="row">
                                @if (ViewBag.isError)
                                {
                                    <div class="col-lg-12">
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            <i class="bi bi-exclamation-octagon me-1"></i>
                                            @Html.Raw(@ViewBag.errorMsg)
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    </div>
                                }
                                <div class="col-lg-12">
                                    <div class="row mb-3">
                                        <label for="title" asp-for="BodyPart" class="col-md-4 col-lg-3 col-form-label">Body Part</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input type="text" class="form-control required" asp-for="BodyPart">
                                            <span asp-validation-for="BodyPart" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label for="title" asp-for="GroupName" class="col-md-4 col-lg-3 col-form-label">Group Name</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input type="text" class="form-control required" asp-for="GroupName">
                                            <span asp-validation-for="GroupName" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label for="title" asp-for="DisplayOrder" class="col-md-4 col-lg-3 col-form-label">Display Order</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input type="text" class="form-control required" asp-for="DisplayOrder">
                                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">

                                        <div class="col-sm-10">
                                            <button type="submit" class="btn btn-primary">Save</button>
                                            <a class="btn btn-primary" asp-action="Index" asp-controller="DiagnoCodeGroup">Back</a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </section>


</main><!-- End #main -->
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

