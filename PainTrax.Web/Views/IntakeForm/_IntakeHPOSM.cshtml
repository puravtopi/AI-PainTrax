    function restoreAccordion() {

        var openAccordion = sessionStorage.getItem('openAccordion');

        if (openAccordion) {

            var accordionElement = document.getElementById(openAccordion);

            if (accordionElement) {

                var bsCollapse = new bootstrap.Collapse(accordionElement, {
                    toggle: false
                });

                bsCollapse.show();
            }

            // clear storage
            sessionStorage.removeItem('openAccordion');
        }
    }
