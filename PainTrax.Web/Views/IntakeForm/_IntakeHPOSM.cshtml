<link href="~/assets/img/favicon.png" rel="icon">
<link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">
@using PainTrax.Web.Helper
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
@{
    Layout = "~/Views/Shared/_IntakeLayout.cshtml";  // Use the admin layout
    var userDesignation = HttpContextAccessor.HttpContext.Session.GetString(SessionKeys.SessionDesignation);
}


<link href="~/assets/css/intakesheet.css" rel="stylesheet" />

<main id="main" class="main" style="margin-left:0px!important">

    <section class="section">
        <div class="col-lg-12">

            <div class="row">
                <!-- LEFT: FORM -->
                <div class="col-md-12 col-12" id="formSection" name="formSection">
                    <button id="uploadDL"
                            class="btn btn-sm btn-outline-primary mt-3" onclick="fnshowDLPopup()" style="display:none;">
                        Upload Driving License
                    </button>

                    <div id="pdfLoader" style="
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(255,255,255,0.8);
    z-index:99999;
    text-align:center;">

                        <div style="
        position:absolute;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
    ">
                            <div class="spinner-border text-primary" role="status"
                                 style="width:4rem;height:4rem;">
                            </div>

                            <div style="margin-top:15px;font-size:18px;font-weight:bold;">
                                Loading...
                            </div>
                        </div>
                    </div>
                    <form method="post" id="patientForm" name="patientForm" class="container my-4">
                        <input type="hidden" id="hdId" name="hdId" value="@ViewBag.Id" />
                        <input type="hidden" id="PatientSubmitDate" name="PatientSubmitDate" value="@ViewBag.SubmitDate" />
                        <input type="hidden" id="LocationId" name="LocationId" value="@ViewBag.LocId" />
                        <input type="hidden" id="DLPath" name="DLPath" />
                        <input type="hidden" id="hdIEId" name="hdIEId" />
                        <input type="hidden" id="hdSelectedBody" name="hdSelectedBody" />
                        <input type="hidden" id="Diagnosis" name="Diagnosis" />
                        <input type="hidden" id="TreatmentIds" name="TreatmentIds" />
                        <input type="hidden" id="TreatmentDesc" name="TreatmentDesc" />
                        <input type="hidden" id="TreatmentDelimitDesc" name="TreatmentDelimitDesc" />
                        <h4 class="text-center mb-4 fw-bold">
                            Hudson Pro Initial Intake
                        </h4>
                        <div class="d-flex justify-content-end align-items-start gap-2">

                            <p id="btnSaveSection" class="mb-0 sticky-buttons">
                                <button type="button"
                                        class="btn btn-secondary"
                                        onclick="window.location.href='@Url.Action("GetProvider", "Home")'">
                                    <i class="bi bi-house-door-fill"></i> Home
                                </button>
                                <button type="submit" class="btn btn-primary">Submit</button>
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        onclick="saveForm(false)">
                                    Save
                                </button>
                                <button type="button" id="btnSuperBill"
                                        class="btn btn-outline-primary"
                                @(Convert.ToInt32(ViewBag.Id) == 0 ? "disabled" : "")
                                        onclick="DownloadPdf('@ViewBag.Id')">
                                    Super Bill
                                </button>
                            </p>

                            <div class="dropdown">
                                <button class="btn btn-light border shadow-sm rounded-circle"
                                        type="button"
                                        id="settingsDropdown"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <i class="bi bi-gear-fill"></i>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow"
                                    aria-labelledby="settingsDropdown">

                                    <li>
                                        <a class="dropdown-item"
                                           onclick="fnshowPatientList()"
                                           href="javascript:void(0)">
                                            <i class="bi bi-calendar-check me-2"></i>
                                            Today's Visit
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           href="javascript:void(0)"
                                           onclick="fndownloadPDF()">
                                            <i class="bi bi-file-earmark-text me-2"></i>
                                            Export as PDF
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           href="javascript:void(0)"
                                           onclick="fnAddFU()">
                                            <i class="bi bi-file-earmark-text me-2"></i>
                                            Add Followup
                                        </a>
                                    </li>

                                </ul>
                            </div>

                        </div>

                        <br />

                        <div class="border p-4 rounded shadow-sm" style="line-height: 2; font-size: 15px;background-color:white">
                            <b><i>*Note: Please do not use single quot(') in any fields.</i></b>
                            <div class="accordion" id="accordionExample">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                            Patient Details
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <!-- Injury Type -->
                                           <div class="select-group">
                                                Case Type:
                                                <label><input type="radio" name="InjuryType" value="nf" /> 
                                                    <span class="select-btn">NF</span>
                                                    </label>
                                                <label><input type="radio" name="InjuryType" value="work-related" />
                                                    <span class="select-btn">WC</span>
                                                    </label>
                                                <label><input type="radio" name="InjuryType" value="mm" />
                                                    <span class="select-btn">MM</span>
                                                    </label>
                                                <label><input type="radio" name="InjuryType" value="lien" /> 
                                                    <span class="select-btn">Lien</span>
                                                    </label>
                                           </div>
                                            <div class="select-group">

                                                DOS
                                                <input id="DOE" name="DOE" type="date" class="form-control d-inline" style="width:125px" oninput="validateYear(this)" />
                                                @* <input id="DOE" name="DOE" type="date" class="form-control d-inline w-auto" /> *@
                                                &nbsp;&nbsp;
                                                Location: &nbsp;&nbsp;
                                             
                                                <select id="LocationId" name="LocationId" asp-items="@ViewBag.locList" class="form-select d-inline w-auto" style="width:230px !important">
                                                </select>
                                                &nbsp;&nbsp;
                                                @* Interpreter Used:   *@
                                                <label><input type="checkbox" class="chkMulti" name="InterpreterUsed" value="Yes"/> <span class="select-btn">Interpreter Used</span></label>
                                                &nbsp;&nbsp;
                                                See Dictation: @* <input id="Dictation" name="Dictation" class="form-control d-inline" style="width:150px;" /> *@
                                                <input id="Dictation" class="form-control d-inline" style="width:20%" value="None" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'Dictation')"></i>
                                            </div>

                                            <!-- Patient Info -->
                                            <div class="select-group">
                                                Patient LName:
                                                <input id="LN" name="LN" class="form-control d-inline" style="width:150px;" />
                                                FName:
                                                <input id="FN" name="FN" class="form-control d-inline" style="width:150px;" />
                                                @*  <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PatientName')"></i> *@
                                                Gender
                                                <select id="Gender" name="Gender" class="form-select d-inline w-auto" style="width:50px !important">
                                                    <option value="male">M</option>
                                                    <option value="female">F</option>
                                                </select>
                                                &nbsp;&nbsp;
                                                handed:
                                                <select id="DominantHand" name="DominantHand" class="form-select d-inline w-auto" style="width:50px !important">
                                                    <option value="right-handed">R</option>
                                                    <option value="left-handed">L</option>
                                                    <option value="ambidextrous">A</option>
                                                </select>
                                                <input id="txtDominantHand" class="form-control d-inline w-25" value="None" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtDominantHand')"></i>
                                                <p>
                                                DOB:
                                                <input id="DOB" name="DOB" type="date" class="form-control d-inline" style="width:125px" oninput="formatDOB(this)" onblur="validateDOB(this)" />
                                                &nbsp;&nbsp; Age:
                                                <input id="Age" name="Age" class="form-control d-inline" style="width:50px" /> years
                                               
                                                &nbsp;&nbsp;DOA:                                                
                                                <input id="DOA" name="DOA" type="date" class="form-control d-inline" style="width:125px" oninput="validateYear(this)" />
                                                </p>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingTwo">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                            History
                                        </button>
                                    </h2>
                                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <!-- Chief Complaint -->
                                             <div class="select-group">
                                                <b> Chief complaint:</b>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Shoulder" data-section="rshSection" data-pe="rshPE" /> <span class="select-btn">Right Shoulder</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Shoulder" data-section="lshSection" data-pe="lshPE" /> <span class="select-btn">Left Shoulder</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Knee" data-section="rknSection" data-pe="rknPE" /> <span class="select-btn">Right Knee</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Knee" data-section="lknSection" data-pe="lknPE" /> <span class="select-btn">Left Knee</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Elbow" data-section="relbowSection" data-pe="relbowPE" /> <span class="select-btn">Right Elbow</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Elbow" data-section="lelbowSection" data-pe="lelbowPE" /> <span class="select-btn">Left Elbow</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Right Hip" data-section="rhipSection" data-pe="rhipPE" /> <span class="select-btn">Right Hip</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Left Hip" data-section="lhipSection" data-pe="lhipPE" /> <span class="select-btn">Left Hip</span></label>
                                                <input type="text" id="OtherBodyPart" name="OtherBodyPart" class="form-control d-inline w-auto" placeholder="other" />
                                           </div>

                                            
                                            <!-- Work -->
                                           
                                            <div class="select-group">
                                                Working:
                                                <label><input type="radio" name="IsWorking" value="The patient is currently working"> <span class="select-btn">Yes</span></label>
                                                <label><input type="radio" name="IsWorking" value="The patient stopped working immediately after accident."> <span class="select-btn">No</span></label>
                                                <span id="divWorking" style="display:none">
                                                    &nbsp;&nbsp;
                                                    <label><input type="radio" id="PartTime" name="YesWork" value="Part time."> <span class="select-btn">Part-time</span></label>
                                                    <label><input type="radio" id="FullTime" name="YesWork" value="Full time">  <span class="select-btn">Full-time</span></label>

                                                </span>
                                                &nbsp;&nbsp;&nbsp;&nbsp;
                                                Degree of Disability <input id="degree" class="form-control d-inline" style="width:250px" /> %.


                                            </div>
                                            <!-- HPI -->
                                             <div class="select-group">
                                                <b> HPI:</b>
                                                Type of Injury:
                                                <label><input type="radio" id="FullTime" name="InjuryTypeHPI" value="MVA">  <span class="select-btn">MVA</span></label>
                                                <label><input type="radio" id="FullTime" name="InjuryTypeHPI" value="Work-Related">  <span class="select-btn">Work-Related</span></label>
                                                <label><input type="radio" id="FullTime" name="InjuryTypeHPI" value="Slip and fall">  <span class="select-btn">Slip and fall</span></label>
                                                <label><input type="radio" id="FullTime" name="InjuryTypeHPI" value="Pedestrian-struck">  <span class="select-btn">Pedestrian-struck</span></label>
                                                <label><input type="radio" id="FullTime" name="InjuryTypeHPI" value="Cyclist-struck">  <span class="select-btn">Cyclist-struck</span></label>
                                                <label><input type="radio" id="FullTime" name="InjuryTypeHPI" value="e-bike">  <span class="select-btn">e-bike</span></label>


                                                @* <label><input type="checkbox" class="chkMulti" name="InjuryTypeHPI" value="MVA"> <span class="select-btn">MVA</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="InjuryTypeHPI" value="Work-Related"> <span class="select-btn">Work-Related</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="InjuryTypeHPI" value="Slip and fall"> <span class="select-btn">Slip and fall</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="InjuryTypeHPI" value="Pedestrian-struck"> <span class="select-btn">Pedestrian-struck</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="InjuryTypeHPI" value="Cyclist-struck"> <span class="select-btn">Cyclist-struck</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="InjuryTypeHPI" value="e-bike"> <span class="select-btn">e-bike</span> </label> *@
                                                <p>
                                                accident Others
                                                <input type="text" class="form-control d-inline w-25" name="InjuryTypeOther" id="InjuryTypeOther" />.
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'InjuryTypeOther')"></i>
                                                </p>
                                                </div>
                                            <div class="select-group">
                                                Patient reports being:
                                                <label><input type="checkbox" class="chkMulti" name="PatientType" value="Pedestrian"> <span class="select-btn">Pedestrian</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientType" value="Bicyclist"> <span class="select-btn">Bicyclist</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientType" value="Motorcyclist"> <span class="select-btn">Motorcyclist</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientType" value="Bus Passenger"> <span class="select-btn">Bus Passenger</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientType" value="Driver"><span class="select-btn">Driver</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientType" value="Front Passenger"> <span class="select-btn">Front Passenger</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientType" value="Rear Passenger"> <span class="select-btn">Rear Passenger</span> </label>
                                                Restrained:
                                                <label><input type="radio" name="PatientTypeYN" value="Yes"> <span class="select-btn">Yes</span></label>
                                                <label><input type="radio" name="PatientTypeYN" value="No"><span class="select-btn">No</span> </label>
                                            </div>
                                            <div class="select-group">
                                                Vehicle hit:
                                                <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Rear"> <span class="select-btn">Rear</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Front"><span class="select-btn">Front</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Driver side front"> <span class="select-btn">Driver-side front</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Driver side Rear"> <span class="select-btn">Driver-side rear</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Passenger side front"> <span class="select-btn">Passenger-side front</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="Passenger side rear"> <span class="select-btn">Passenger-side rear</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="T-boned Driver side"> <span class="select-btn">T-boned Driver side</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="VehicleHit" value="T-boned Passenger side"> <span class="select-btn">T-boned Passenger side</span></label>
                                            </div>

                                            <p>
                                                Accident Description
                                                <textarea id="AccidentDescription" name="AccidentDescription" class="form-control d-inline" style="width:95%"></textarea>
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'AccidentDescription')"></i>
                                            </p>
                                            <div class="select-group">
                                                <b> Mechanism of Injury:</b>
                                                Air bags deployed:
                                                <label><input type="radio" name="Airbag" value="Yes"> <span class="select-btn">Yes</span></label>
                                                <label><input type="radio" name="Airbag" value="No"> <span class="select-btn">No</span></label>
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                EMS arrived:
                                                <label><input type="radio" name="EMS" value="Yes"> <span class="select-btn">Yes</span></label>
                                                <label><input type="radio" name="EMS" value="No"> <span class="select-btn">No</span></label>
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                Police arrived:
                                                <label><input type="radio" name="Police" value="Yes"> <span class="select-btn">Yes</span></label>
                                                <label><input type="radio" name="Police" value="No"> <span class="select-btn">No</span></label>
                                               <p>
                                                LOC:
                                                <label><input type="radio" name="PoliceReport" value="Yes"> <span class="select-btn">Yes</span></label>
                                                <label><input type="radio" name="PoliceReport" value="No"> <span class="select-btn">No</span></label>
                                                <div id="divLOC" style="display:none">


                                                        <input id="txtLOC" class="form-control d-inline w-25" />
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtLOC')"></i>
                                                </div>

                                                </p>
                                            </div>
                                            <!-- Hospital -->
                                           
                                            <div class="select-group">
                                                <p>
                                                    
                                                    Went to hospital:
                                                    <label><input type="radio" name="Hospital" value="Yes"> <span class="select-btn">Yes</span></label>
                                                    <label><input type="radio" name="Hospital" value="No"> <span class="select-btn">No</span></label>
                                                    <span id="divHospitalName" style="display:none">
                                                        Hospital name:
                                                        <input id="HospitalName" class="form-control d-inline" style="width:200px" />
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'HospitalName')"></i>
                                                    </span>
                                                </p>
                                                <div id="divHospital" style="display:none">                                                   
                                                    <label><input type="radio" name="Records" value="Yes"> <span class="select-btn">Discharged the same day</span></label>
                                                    <label><input type="radio" name="Records" value="No"> <span class="select-btn">Admitted</span></label>
                                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                    How did you get to hospital:
                                                    <label><input type="radio" name="Transport" value="Ambulance"> <span class="select-btn">Ambulance</span></label>
                                                    <label><input type="radio" name="Transport" value="Car"> <span class="select-btn">Car</span></label>
                                                    <label><input type="radio" name="Transport" value="Uber"> <span class="select-btn">Uber</span></label>
                                                    <label><input type="radio" name="Transport" value="Cab"> <span class="select-btn">Cab</span></label>
                                                    <label><input type="radio" name="Transport" value="Friend"> <span class="select-btn">Friend</span></label>
                                                   
                                                </div>
                                              </div>
                                          

                                           @*  <div class="patient-history"> *@

                                                <div class="select-group">
                                                    <strong>Any symptoms prior to accident:</strong>

                                                   
                                                         <label><input type="radio" name="PriorSymptoms" value="Y"> <span class="select-btn">Yes</span></label>

                                                <label> <input type="radio" name="PriorSymptoms" value="N"> <span class="select-btn">No</span></label>
                                                    
                                                    <div id="divPriorSymptoms" style="display:none">


                                                        <input id="txtPriorSymptoms" class="form-control d-inline w-25" />
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtPriorSymptoms')"></i>
                                                </div>
                                                </div>

                                               <div class="select-group">
                                                    <strong>History of Prior Trauma:</strong>

                                                   
                                                         <label><input type="radio" name="PriorTrauma" value="Y"> <span class="select-btn">Yes</span></label>

                                                <label> <input type="radio" name="PriorTrauma" value="N"> <span class="select-btn">No</span></label>
                                                    
                                                    <div id="divPriorTrauma" style="display:none">


                                                        <input id="txtPriorTrauma" class="form-control d-inline w-25" />
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtPriorTrauma')"></i>
                                                    </div>
                                            </div>

                                                <div class="select-group">
                                                    <strong>Transportation: How did you get to the office today?</strong>

                                                    <label>
                                                        <input type="checkbox" class="chkMulti" name="Transportation" value="Self"> <span class="select-btn">Self</span>
                                                    </label>

                                                    <label>
                                                        <input type="checkbox" class="chkMulti" name="Transportation" value="Drove"> <span class="select-btn">Drove</span>
                                                    </label>

                                                    <label>
                                                        <input type="checkbox" class="chkMulti" name="Transportation" value="Family member"> <span class="select-btn">Family member</span>
                                                    </label>

                                                    <label>
                                                        <input type="checkbox" class="chkMulti" name="Transportation" value="Uber"> <span class="select-btn">Uber</span>
                                                    </label>

                                                    <label>
                                                        <input type="checkbox" class="chkMulti" name="Transportation" value="Self transportation"> <span class="select-btn">Self - transportation</span>
                                                    </label>
                                                    <p>
                                                    Others:
                                                    <input id="TransportationOther" class="form-control d-inline w-25" style="min-width:250px" />

                                                    <i class="fa fa-microphone d-inline mic-btn"
                                                       onclick="startVoice(this,'TransportationOther')"></i>
                                                    </p>
                                               </div>

                                                <div class="select-group">
                                                    <strong>Needs daily life activity assistance:</strong>
                                                    
                                                    <label>
                                                        <input type="radio" name="DailyLifeAssistance" value="Y"> <span class="select-btn">Yes</span></label>                                                 
                                                       <label>  <input type="radio" name="DailyLifeAssistance" value="N"> <span class="select-btn">No</span>                                                   
                                                    </label>
                                                <p>
                                                    <input id="DailyLifeAssistanceOther" class="form-control d-inline w-25" style="min-width:250px" />
                                                    <i class="fa fa-microphone d-inline mic-btn"
                                                       onclick="startVoice(this,'DailyLifeAssistanceOther')"></i>
                                                    </p>
                                    </div>

                                           @*  </div> *@
                                            <div class="select-group">
                                               @*  <strong> Medical History & Functional Status:</strong> *@
                                              
                                               <p>
                                                    PMH:
                                                <label><input type="checkbox" class="chkMulti" name="PMH" value="None"> <span class="select-btn">None</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="Diabetes"> <span class="select-btn">Diabetes</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="HTN"> <span class="select-btn">HTN</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="HLD"> <span class="select-btn">HLD</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="Asthma"> <span class="select-btn">Asthma</span></label>
