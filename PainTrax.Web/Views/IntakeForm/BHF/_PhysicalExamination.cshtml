<div id="neckPE" style="display:none">
    <h6 class="fw-bold">Neck</h6>
    <div class="select-group">
        Patient has pain and tenderness over the   <input id="NeckTenderness" class="form-control d-inline " style="width:100px" />
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'NeckTenderness')"></i> facet joints. Facet loading maneuvers are positive.
        Spurling’s Test:
        <label><input type="radio" name="NeckSpurlingTest" value="Positive">  <span class="select-btn">+</span></label>
        <label><input type="radio" name="NeckSpurlingTest" value="Negative">  <span class="select-btn">-</span></label>
        <input id="NeckSpurlingTestOther" class="form-control d-inline " style="width:100px" placeholder="Other" />
    </div>
    <table style="width:100%">
        <thead>
            <tr>
                <td></td>
                <td>ROM</td>
                <td>Normal</td>
                <td></td>
                <td>Left</td>
                <td>Right</td>
                <td>Normal</td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Forward Flexion</td>
                <td><input id="NeckFFROM" class="form-control d-inline " maxlength="3" style="width:50px" /> </td>
                <td>50</td>
                <td>Rotation</td>
                <td><input id="NeckFFLeft" class="form-control d-inline " maxlength="3" style="width:50px" /></td>
                <td><input id="NeckFFRight" class="form-control d-inline " maxlength="3" style="width:50px" /></td>
                <td>80</td>
            </tr>
            <tr>
                <td>Extension</td>
                <td><input id="NeckExt" class="form-control d-inline " maxlength="3" style="width:50px" /> </td>
                <td>60</td>
                <td>Lateral Flexion</td>
                <td><input id="NeckExtLeft" class="form-control d-inline " maxlength="3" style="width:50px" /></td>
                <td><input id="NeckExtRight" class="form-control d-inline " maxlength="3" style="width:50px" /></td>
                <td>45</td>
            </tr>
        </tbody>
    </table>
</div>
