<div id="rshSection" style="display:none;">
    <h6 class="fw-bold">Right Shoulder (R/Sh)</h6>

    <p>
        Pain:
        <input id="RShPain" class="form-control d-inline w-auto" style="width:80px;" />
        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'RShPain')"></i>/10

        <label><input type="checkbox" class="chkMulti" name="RShSymptoms" value="Constant"> Constant</label>
        <label><input type="checkbox" class="chkMulti" name="RShSymptoms" value="Intermittent"> Intermittent</label>

        <label><input type="checkbox" class="chkMulti" name="RShSymptoms" value="Stiff"> Stiff</label>
        <label><input type="checkbox" class="chkMulti" name="RShSymptoms" value="Weak"> Weak</label>
        <label><input type="checkbox" class="chkMulti" name="RShSymptoms" value="Pop"> Pop</label>
        <label><input type="checkbox" class="chkMulti" name="RShSymptoms" value="Click"> Click</label>
    </p>

    <p>
        Diff Reach overhead:
        <label><input type="radio" name="RShReachOverhead" value="Yes"> Y</label>
        <label><input type="radio" name="RShReachOverhead" value="No"> N</label>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        Diff Reach back:
        <label><input type="radio" name="RShReachBack" value="Yes"> Y</label>
        <label><input type="radio" name="RShReachBack" value="No"> N</label>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        Unable to sleep at night:
        <label><input type="radio" name="RShSleepIssue" value="Yes"> Y</label>
        <label><input type="radio" name="RShSleepIssue" value="No"> N</label>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        Improved with:
        <label><input type="checkbox" class="chkMulti" name="RShImprove" value="Rest"> Rest</label>
        <label><input type="checkbox" class="chkMulti" name="RShImprove" value="Med"> Med</label>
        <label><input type="checkbox" class="chkMulti" name="RShImprove" value="PT"> PT</label>
        <label><input type="checkbox" class="chkMulti" name="RShImprove" value="Ice"> Ice</label>
    </p>

</div>

