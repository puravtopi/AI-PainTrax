<table cellspacing="0" cellpadding="5"
       style="border-collapse: collapse; width:100%;">

    <thead>
        <tr style="font-weight:bold; ">
            <td style="width:50%;">ADL</td>
            <td>Perform</td>
            <td>Not Perform</td>
            <td>With Difficulty</td>
            <td>Comments</td>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>
                <label>
                    @* <input type="checkbox" name="ADLPersonalHygiene" /> *@
                    Personal hygiene, grooming, dressing, toileting
                </label>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLPersonalHygienePerform"  value="Yes"/>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLPersonalHygienePerform" value="No" />
            </td>
            <td>
                <input type="radio" name="ADLPersonalHygieneDifficulty" onclick="uncheckRadio(this)" value="Yes" />
            </td>

            <td>
                <input type="text"
                       id="txtADLPersonalHygieneDifficulty"
                       name="txtADLPersonalHygieneDifficulty"
                       class="form-control d-inline w-50" />
                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtADLPersonalHygieneDifficulty')"></i>
            </td>
        </tr>

        <tr>
            <td>
                <label>
                    @* <input type="checkbox" name="ADLWalking" /> *@
                    Walking, transferring, ambulating
                </label>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLWalkingPerform"  value="Yes"/>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLWalkingPerform" value="No" />
            </td>
            <td>
                <input type="radio" name="ADLWalkingDifficulty" onclick="uncheckRadio(this)" value="Yes" />
            </td>

            <td>
                <input type="text"
                       id="txtADLWalkingDifficulty"
                       name="txtADLWalkingDifficulty"
                       class="form-control d-inline w-50" />
                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtADLWalkingDifficulty')"></i>
            </td>
        </tr>

        <tr>
            <td>
                <label>
                    @* <input type="checkbox" name="ADLEating" /> *@
                    Eating independently
                </label>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLEatingPerform"  value="Yes"/>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLEatingPerform" value="No" />
            </td>
            <td>
                <input type="radio" name="ADLEatingDifficulty" value="Yes" onclick="uncheckRadio(this)" />
            </td>

            <td>
                <input type="text"
                       id="txtADLEatingDifficulty"
                       name="txtADLEatingDifficulty"
                       class="form-control d-inline w-50" />
                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtADLEatingDifficulty')"></i>
            </td>
        </tr>

        <tr>
            <td>
                <label>
                    @* <input type="checkbox" name="ADLHousehold" /> *@
                    Cook, clean, maintain households
                </label>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLHouseholdPerform"  value="Yes"/>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLHouseholdPerform" value="No" />
            </td>
            <td>
                <input type="radio" name="ADLHouseholdDifficulty" value="Yes" onclick="uncheckRadio(this)" />
            </td>

            <td>
                <input type="text"
                       name="txtADLHouseholdDifficulty"
                       id="txtADLHouseholdDifficulty"
                       class="form-control d-inline w-50" />
                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtADLHouseholdDifficulty')"></i>
            </td>
        </tr>

        <tr>
            <td>
                <label>
                    @* <input type="checkbox" name="ADLShopping" /> *@
                    Shop for food
                </label>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLShoppingPerform"  value="Yes"/>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLShoppingPerform" value="No" />
            </td>
            <td>
                <input type="radio" name="ADLShoppingDifficulty" value="Yes" onclick="uncheckRadio(this)" />
            </td>

            <td>
                <input type="text"
                       name="txtADLShoppingDifficulty"
                       id="txtADLShoppingDifficulty"
                       class="form-control d-inline w-50" />
                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtADLShoppingDifficulty')"></i>
            </td>
        </tr>

        <tr>
            <td>
                <label>
                    @* <input type="checkbox" name="ADLSleeping" /> *@
                    Sleeping
                </label>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLSleepingPerform"  value="Yes"/>
            </td>

            <td style="text-align:center;">
                <input type="radio" name="ADLSleepingPerform" value="No" />
            </td>
            <td>
                <input type="radio" name="ADLSleepingDifficulty" value="Yes" onclick="uncheckRadio(this)" />
            </td>

            <td>
                <input type="text"
                       name="txtADLSleepingDifficulty"
                       id="txtADLSleepingDifficulty"
                       class="form-control d-inline w-50" />
                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'txtADLSleepingDifficulty')"></i>
            </td>
        </tr>
    </tbody>
</table>
<script>
    function uncheckRadio(radio) {
        if (radio.dataset.wasChecked === "true") {
            radio.checked = false;
            radio.dataset.wasChecked = "false";
        } else {
            document.querySelectorAll(`input[name="${radio.name}"]`)
                .forEach(r => r.dataset.wasChecked = "false");

            radio.dataset.wasChecked = "true";
        }
    }
</script>