         ];

         for (const item of validations) {

             const isValid = validateBodySection(
                 item.bodyPart,
                 item.complaintSectionId,
                 item.peSectionId
             );

             if (!isValid)
                 return false;
         }

         return true;
     }

     function toggleSection(condition, selector) {
         $(selector).toggle(condition);
     }
     function validateYear(input) {

        if (input.value) {

            let year = input.value.split("-")[0];

            if (year.length > 4) {

                alert("Year must be 4 digits only.");
                input.value = "";
            }
        }
    }
    function validateDOB(input) {

        if (!input.value)
            return;

        let year = input.value.split("-")[0];

        // Check year length
        if (year.length > 4){

            alert("Year must be 4 digits only");
            input.value = "";
            return;
        }

        let selectedDate = new Date(input.value);
        let minDate = new Date("1900-01-01");
        let today = new Date();

        today.setHours(0, 0, 0, 0);

        // Check minimum date
        if (selectedDate < minDate) {

            alert("DOB should be after 01/01/1900");
            input.value = "";
            return;
        }

        // Check future date
        if (selectedDate > today) {

            alert("Future date is not allowed");
            input.value = "";
            return;
        }
    }
    function formatDOB(input) {
        var dob = $('#dob').val();
        // ---------- DOB ----------
        if (dob) {
            dobDate = validateDateStrict(dob, "DOB", true);
            if (!dobDate) return;
        }
    }
    function validateDateStrict(dateStr, fieldLabel, blockFuture) {

        // Accept only YYYY-MM-DD (what <input type="date"> returns)
        var regex = /^(19\d{2}|20\d{2})-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;

        if (!regex.test(dateStr)) {
            alert(fieldLabel + " must be after 01/01/1900");
            return null;
        }

        var parts = dateStr.split('-');
        var year  = parseInt(parts[0], 10);
        var month = parseInt(parts[1], 10);
        var day   = parseInt(parts[2], 10);

        var date = new Date(year, month - 1, day);

        // Invalid calendar date
        if (
            date.getFullYear() !== year ||
            date.getMonth() !== month - 1 ||
            date.getDate() !== day
        ) {
            alert("Invalid " + fieldLabel);
            return null;
        }

        // DOB cannot be future
        if (blockFuture) {
            var today = new Date();
            today.setHours(0, 0, 0, 0);

            if (date > today) {
                alert(fieldLabel + " cannot be future date");
                return null;
            }
        }

        return date;
    }
