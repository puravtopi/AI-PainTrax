<link href="~/assets/img/favicon.png" rel="icon">
<link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
@{
    Layout = "~/Views/Shared/_IntakeLayout.cshtml";  // Use the admin layout
}


<link href="~/assets/css/intakesheet.css" rel="stylesheet" />
<main id="main" class="main" style="margin-left:0px!important">

    <section class="section">
        <div class="col-lg-12">

            <div class="row">
                <!-- LEFT: FORM -->
                <div class="col-md-12 col-12" id="formSection" name="formSection">
                    <button id="uploadDL"
                            class="btn btn-sm btn-outline-primary mt-3" onclick="fnshowDLPopup()" style="display:none;">
                        Upload Driving License
                    </button>
                    @* <div class="d-flex justify-content-end mb-2">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-primary mt-3" onclick="fndownloadPDF()">
                                Export as PDF
                            </button>
                           
                        </div>
                    </div> *@

                    @* <button id="uploadDL" style="display:none;"
                            class="btn btn-sm btn-outline-primary mt-3" onclick="fnshowDLPopup()">
                        Upload Driving License
                    </button> *@
                    <div id="pdfLoader" style="
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(255,255,255,0.8);
    z-index:99999;
    text-align:center;">

                        <div style="
        position:absolute;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
    ">
                            <div class="spinner-border text-primary" role="status"
                                 style="width:4rem;height:4rem;">
                            </div>

                            <div style="margin-top:15px;font-size:18px;font-weight:bold;">
                                Loading...
                            </div>
                        </div>
                    </div>
                    <form method="post" id="patientForm" name="patientForm" class="container my-4">
                        <input type="hidden" id="hdId" name="hdId" value="@ViewBag.Id" />
                        <input type="hidden" id="PatientSubmitDate" name="PatientSubmitDate" value="@ViewBag.SubmitDate" />
                        <input type="hidden" id="LocationId" name="LocationId" value="@ViewBag.LocId" />
                        <input type="hidden" id="DLPath" name="DLPath" />
                        <input type="hidden" id="hdIEId" name="hdIEId" />
                        <input type="hidden" id="hdSelectedBody" name="hdSelectedBody" />
                        <input type="hidden" id="Diagnosis" name="Diagnosis" />
                        <input type="hidden" id="TreatmentIds" name="TreatmentIds" />
                        <input type="hidden" id="TreatmentDesc" name="TreatmentDesc" />
                        <input type="hidden" id="TreatmentDelimitDesc" name="TreatmentDelimitDesc" />
                        <h4 class="text-center mb-4 fw-bold">
                            Patient Injury Report
                        </h4>
                        <div class="d-flex justify-content-end align-items-start gap-2">

                            <p id="btnSaveSection" class="mb-0 sticky-buttons">
                                <button type="button"
                                        class="btn btn-secondary"
                                        onclick="window.location.href='@Url.Action("GetProvider", "Home")'">
                                    <i class="bi bi-house-door-fill"></i> Home
                                </button>
                                <button type="submit" class="btn btn-primary">Submit</button>
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        onclick="saveForm(false)">
                                    Save
                                </button>
                                <button type="button"
                                        class="btn btn-outline-primary"
                                             @( Convert.ToInt32(ViewBag.Id) == 0 ? "disabled" : "")
                                             onclick="DownloadPdf('@ViewBag.Id')">
                                    Super Bill
                                </button>
                            </p>

                            <div class="dropdown">
                                <button class="btn btn-light border shadow-sm rounded-circle"
                                        type="button"
                                        id="settingsDropdown"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <i class="bi bi-gear-fill"></i>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow"
                                    aria-labelledby="settingsDropdown">

                                    <li>
                                        <a class="dropdown-item"
                                           onclick="fnshowPatientList()"
                                           href="javascript:void(0)">
                                            <i class="bi bi-calendar-check me-2"></i>
                                            Today's Visit
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           href="javascript:void(0)"
                                           onclick="fndownloadPDF()">
                                            <i class="bi bi-file-earmark-text me-2"></i>
                                            Export as PDF
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           href="javascript:void(0)"
                                           onclick="fnAddFU()">
                                            <i class="bi bi-file-earmark-text me-2"></i>
                                            Add Followup
                                        </a>
                                    </li>

                                </ul>
                            </div>

                        </div>

                        <br />
                        <div class="border p-4 rounded shadow-sm" style="line-height: 2; font-size: 15px;background-color:white">
                            <b><i>*Note: Please do not use single quot(') in any fields.</i></b>

                            <div class="accordion" id="accordionExample">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                            Patient Details
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <br />
                                            <h6>Provider Name:  @ViewBag.ProviderName</h6>
                                            <!-- Patient Info -->
                                            <div class="select-group">
                                                Patient LName:
                                                <input id="LN" name="LN" class="form-control d-inline" style="width:150px;" />
                                                FName:
                                                <input id="FN" name="FN" class="form-control d-inline" style="width:150px;" />
                                                @*  <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PatientName')"></i> *@
                                                Gender
                                                <select id="Gender" name="Gender" class="form-select d-inline w-auto" style="width:50px !important">
                                                    <option value="male">M</option>
                                                    <option value="female">F</option>
                                                </select>
                                                &nbsp;&nbsp;
                                                handed:
                                                <select id="DominantHand" name="DominantHand" class="form-select d-inline w-auto" style="width:50px !important">
                                                    <option value="right-handed">R</option>
                                                    <option value="left-handed">L</option>
                                                </select>
                                                &nbsp;&nbsp;

                                                @*  DOA
                                                <input id="DOA" name="DOA" type="date" class="form-control d-inline w-auto" />
                                                &nbsp;&nbsp; *@
                                                Location:
                                                @* <span id="lblLocation">
                                                    @ViewBag.LocName
                                                </span> *@
                                                <select id="LocationId" name="LocationId" asp-items="@ViewBag.locList" class="form-select d-inline w-auto" style="width:230px !important">
                                                </select>
                                            </div>

                                            <div class="select-group">
                                                DOE
                                                <input id="DOE" name="DOE" type="date" class="form-control d-inline" style="width:125px" oninput="validateYear(this)" />
                                                &nbsp;&nbsp;
                                                DOB:
                                                <input id="DOB" name="DOB" type="date" class="form-control d-inline" style="width:125px" oninput="formatDOB(this)" onblur="validateDOB(this)" />
                                                &nbsp;&nbsp;&nbsp;
                                                Age:
                                                <input id="Age" name="Age" class="form-control d-inline" style="width:30px" /> years
                                                &nbsp;&nbsp;&nbsp;

                                                DOA:
                                                <input id="DOA" name="DOA" type="date" class="form-control d-inline" style="width:125px" oninput="validateYear(this)" />
                                                &nbsp;&nbsp;
                                                <label>Case Type:</label>
                                                <label>
                                                    <input type="radio" name="InjuryType" value="NF">
                                                    <span class="select-btn">NF</span>
                                                </label>

                                                <label>
                                                    <input type="radio" name="InjuryType" value="WC">
                                                    <span class="select-btn">WC</span>
                                                </label>

                                                <label>
                                                    <input type="radio" name="InjuryType" value="MM">
                                                    <span class="select-btn">MM</span>
                                                </label>

                                                <label>
                                                    <input type="radio" name="InjuryType" value="PI">
                                                    <span class="select-btn">PI</span>
                                                </label>
                                                <label>
                                                    <input type="radio" name="InjuryType" value="LIEN">
                                                    <span class="select-btn">LIEN</span>
                                                </label>


                                            </div>
                                            <div class="select-group">

                                                Occupation:
                                                <input id="Occupation" name="Occupation" class="form-control d-inline w-auto" style="min-width:90%;" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'Occupation')"></i>
                                            </div>
                                            <div class="select-group">
                                                Working:
                                                <label><input type="radio" name="IsWorking" value="The patient is currently working"> <span class="select-btn">Yes</span></label>
                                                <label><input type="radio" name="IsWorking" value="The patient stopped working immediately after accident."> <span class="select-btn">No</span></label>
                                                <span id="divWorking" style="display:none">
                                                    &nbsp;&nbsp;
                                                     <label><input type="radio" id="PartTime" name="YesWork" value="Part time."> <span class="select-btn">Part-time</span></label>
                                                     <label><input type="radio" id="FullTime" name="YesWork" value="Full time">  <span class="select-btn">Full-time</span></label>

                                                </span>
                                                &nbsp;&nbsp;&nbsp;&nbsp;
                                                Degree of Disability <input id="degree" class="form-control d-inline" style="width:250px" /> %.


                                            </div>


                                            <div class="select-group" style="display:none">
                                                VITAL SIGNS: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                Height:
                                                <input id="Heightft" name="Heightft" class="form-control d-inline" style="width:40px" onchange="calculateBMI()" />ft
                                                <input id="Heightinch" name="Heightinch" class="form-control d-inline" style="width:30px" value="0" onchange="calculateBMI()" />inches
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                Weight:
                                                <input id="Weight" name="Weight" class="form-control d-inline" onchange="calculateBMI()" style="width:100px" />

                                                lbs,

                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;BMI:
                                                <input id="BMI" name="BMI" class="form-control d-inline" style="width:100px" />
                                            </div>

                                            <div class="select-group">
                                                Asymptomatic prior to accident:
                                                <label><input type="radio" name="Asymptomatic" value="Yes"> <span class="select-btn">Y</span></label>
                                                <label><input type="radio" name="Asymptomatic" value="No"> <span class="select-btn">N</span></label>
                                                <span id="divAsymptomatic" style="display:none">
                                                    <input type="text" id="OtherAsymptomatic" name="OtherAsymptomatic" class="form-control d-inline w-auto" />

                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'OtherAsymptomatic')"></i>
                                                </span>
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                History of prior trauma:
                                                <label><input type="radio" name="Priortrauma" value="Yes"> <span class="select-btn">Y</span></label>
                                                <label><input type="radio" name="Priortrauma" value="No"> <span class="select-btn">N</span></label>
                                                <span id="divPriortrauma" style="display:none;width:40%">
                                                    <input type="text" id="OtherPriortrauma" name="OtherPriortrauma" class="form-control d-inline" style="width:95%" />

                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'OtherPriortrauma')"></i>
                                                </span>

                                            </div>
                                            <div class="select-group" >
                                                Accident Type
                                                <label><input type="radio" name="PatientAType" value="Driver"><span class="select-btn"> Driver</span></label>
                                                <label><input type="radio" name="PatientAType" value="Front Pass"><span class="select-btn"> Front Pass</span></label>
                                                <label><input type="radio" name="PatientAType" value="Rear Pass"><span class="select-btn"> Rear Pass</span></label>
                                                <label><input type="radio" name="PatientAType" value="Pedestrian"><span class="select-btn"> Pedestrian</span></label>
                                                <label><input type="radio" name="PatientAType" value="Bicyclist"><span class="select-btn"> Bicyclist</span></label>
                                                @*  <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="Driver"> <span class="select-btn">Driver</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="FrontPass"> <span class="select-btn">Front Pass</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="RearPass"> <span class="select-btn">Rear Pass</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="Pedestrian"><span class="select-btn">Pedestrian</span> </label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="Bicyclist"> <span class="select-btn">Bicyclist</span></label> *@
                                                &nbsp;&nbsp;&nbsp;
                                                Collision Type
                                                <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="Frontend"><span class="select-btn">Front end</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="Rearend"> <span class="select-btn">Rear end</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="Driverside"> <span class="select-btn">Driver side</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="PatientAccidentType" value="Passside"> <span class="select-btn">Pass side</span></label>

                                                <input type="text" id="OtherCollision" name="OtherCollision" class="form-control d-inline" style="width:80%" />

                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'OtherCollision')"></i>
                                            </div>
                                            <div class="select-group">
                                                Seat Belt:
                                                <label><input type="radio" name="SeatBelt" value="Yes"><span class="select-btn"> Y</span></label>
                                                <label><input type="radio" name="SeatBelt" value="No"> <span class="select-btn">N</span></label>
                                                &nbsp;&nbsp;&nbsp;
                                                Airbags deployed:
                                                <label><input type="radio" name="Airbagsdeployed" value="Yes"> <span class="select-btn">Y</span></label>
                                                <label><input type="radio" name="Airbagsdeployed" value="No"><span class="select-btn"> N</span></label>
                                                &nbsp;&nbsp;&nbsp;
                                                LOC:
                                                <label><input type="radio" name="LOC" value="Yes"> <span class="select-btn">Y</span></label>
                                                <label><input type="radio" name="LOC" value="No"> <span class="select-btn">N</span></label>
                                                <span id="divLOC" style="display:none">
                                                    <input type="text" id="OtherLOC" name="OtherLOC" class="form-control d-inline w-auto" />

                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'OtherLOC')"></i>
                                                </span>
                                                &nbsp;&nbsp;&nbsp;
                                                Bruises:
                                                <label><input type="radio" name="Bruises" value="Yes"><span class="select-btn"> Y</span></label>
                                                <label><input type="radio" name="Bruises" value="No"><span class="select-btn"> N</span></label>
                                                <span id="divBruises" style="display:none">
                                                    <input type="text" id="OtherBruises" name="OtherBruises" class="form-control d-inline w-auto" />

                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'OtherBruises')"></i>
                                                </span>

                                            </div>
                                            <div class="select-group">
                                                Hospital:
                                                <label><input type="radio" name="Hospital" value="Yes"> <span class="select-btn">Y</span></label>
                                                <label><input type="radio" name="Hospital" value="No"><span class="select-btn"> N</span></label>
                                                &nbsp;&nbsp;&nbsp;
                                                EMS:
                                                <label><input type="radio" name="EMS" value="Yes"> <span class="select-btn">Y</span></label>
                                                <label><input type="radio" name="EMS" value="No"> <span class="select-btn">N</span></label>
                                                &nbsp;&nbsp;&nbsp;
                                                Private car:
                                                <label><input type="radio" name=" privatecar" value="Yes"> <span class="select-btn">Y</span></label>
                                                <label><input type="radio" name=" privatecar" value="No"><span class="select-btn"> N</span></label>
                                                &nbsp;&nbsp;&nbsp;
                                            </div>


                                            <span id="divHospital" style="display:none">
                                                Hospital name
                                                <input id="hospitalname" name="hospitalname" class="form-control d-inline w-auto" style="min-width:70%;" />
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'hospitalname')"></i>
                                            </span>




                                            <p>
                                                Accident Description
                                                <textarea id="AccidentDescription" name="AccidentDescription" class="form-control d-inline" style="width:95%"></textarea>
                                                <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'AccidentDescription')"></i>
                                            </p>
                                            <div class="select-group">
                                                Chief complaint:
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Neck" data-section="neckSection" data-pe="neckPE" /> <span class="select-btn">Neck</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Midback" data-section="mbSection" data-pe="mbPE" /> <span class="select-btn">Mid back</span></label>
                                                <label><input type="checkbox" class="chkMulti" name="Complaints" value="Lowback" data-section="lbSection" data-pe="lbPE" /> <span class="select-btn">Low back</span></label>

                                                <input type="text" id="OtherBodyPart" name="OtherBodyPart" class="form-control d-inline w-auto" placeholder="other" />
                                            </div>

                                        </div>
                                    </div>
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingTwo">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                                History
                                            </button>
                                        </h2>
                                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                            <div class="accordion-body">

                                                <div class="select-group">
                                                    PMH:
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="None"> <span class="select-btn">None</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="Diabetes"> <span class="select-btn">Diabetes</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="HBP"> <span class="select-btn">HBP</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="HLD"><span class="select-btn"> HLD</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="Asthma"> <span class="select-btn">Asthma</span></label>
                                                    <label><input type="checkbox" class="chkMulti" name="PMH" value="Cardiac disease"> <span class="select-btn">Cardiac disease</span></label>
                                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                    Other:
                                                    <input id="PMHOther" class="form-control d-inline w-25" style="min-width:37%" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PMHOther')"></i>
                                                </div>
                                                <p>
                                                    PSH:
                                                    <input id="PSH" class="form-control d-inline w-50" placeholder="None or details" style="min-width:80%" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PSH')"></i>
                                                </p>
                                                <p>
                                                    Previous Procedures:
                                                    <input id="PProcedures" class="form-control d-inline w-50" placeholder="None or details" style="min-width:80%" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PProcedures')"></i>
                                                </p>
                                                <p>
                                                    Meds:

                                                    <input id="MedsOther" class="form-control d-inline w-25" />
                                                    <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'MedsOther')"></i>
                                                </p>
                                                <!-- Allergies -->
                                                <div class="select-group">
                                                    Allergies:
                                                    <label><input type="radio" name="Allergy" value="No"> <span class="select-btn">No</span></label>
                                                    <label><input type="radio" name="Allergy" value="Yes"> <span class="select-btn">Yes</span></label>
                                                    <span id="divAllergy" style="display:none;width:40%">
                                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                        What Allergy:
                                                        <input id="AllergyReaction" class="form-control d-inline" style="width:95%" />
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'AllergyReaction')"></i>
                                                    </span>
                                                </div>
                                                <div class="select-group">
                                                    Smoker:
                                                    <label><input type="radio" name="Smoke" value="Yes"> <span class="select-btn">Y</span></label>
                                                    <label><input type="radio" name="Smoke" value="No" checked><span class="select-btn"> N</span></label>
                                                    <span id="divSmoke" style="display:none">
                                                        <input id="PPD" class="form-control d-inline" style="width:150px" /> PPD.
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PPD')"></i>
                                                    </span>
                                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                    Alcohol:
                                                    <label><input type="radio" name="Alcohol" value="The patient drinks alcohol occasionally."><span class="select-btn"> Y</span></label>
                                                    <label><input type="radio" name="Alcohol" value="The patient does not drink alcohol." checked><span class="select-btn"> N</span></label>
                                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                    @* Cannabis:
                                                <label><input type="radio" name="Cannabis" value="The patient smokes cannabis."><span class="select-btn"> Y</span></label>
                                                <label><input type="radio" name="Cannabis" value="The patient does not smoke cannabis."><span class="select-btn"> N</span></label>
                                                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; *@
                                                    Drugs:
                                                    <label><input type="radio" name="OtherDrugs" value="Yes"><span class="select-btn"> Y</span></label>
                                                    <label><input type="radio" name="OtherDrugs" value="No" checked><span class="select-btn"> N</span></label>
                                                    <span id="divDrugs" style="display:none">
                                                        <input type="text" id="OtherDrugsTxt" name="OtherDrugsTxt" placeholder="Other Drugs Name" class="form-control d-inline w-auto" />
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'OtherDrugsTxt')"></i>
                                                    </span>
                                                </div>
                                                <div class="select-group">
                                                    Physical therapy:
                                                    <label><input type="radio" name="PT" value="Yes"> <span class="select-btn">Y</span></label>
                                                    <label><input type="radio" name="PT" value="The patient has not had physical therapy."> <span class="select-btn">N</span></label>
                                                    <span id="divPT" style="display:none">
                                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                        If yes, how often:
                                                        <input id="PTFreq" class="form-control d-inline w-25" style="min-width:37%" placeholder="x/week" />
                                                        <i class="fa fa-microphone d-inline mic-btn" onclick="startVoice(this,'PTFreq')"></i>
                                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                        @*  x a week: *@
                                                    </span>
                                                </div>
                                                <div class="select-group">
                                                    Chiropractor:
                                                    <label><input type="radio" name="Chiro" value="Yes"> <span class="select-btn">Y</span></label>
                                                    <label><input type="radio" name="Chiro" value="No"> <span class="select-btn">N</span></label>
                                                    <span id="divChiro" style="display:none">
                                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                        If yes, how often?
