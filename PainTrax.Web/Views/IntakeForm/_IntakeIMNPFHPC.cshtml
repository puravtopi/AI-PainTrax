     dropArea.ondragover = e => e.preventDefault();
     dropArea.ondrop = e => {
         e.preventDefault();
         handleFiles(e.dataTransfer.files);
     };

     // Handle files
     function handleFiles(files) {
         [...files].forEach(file => {
             file.id = Date.now() + Math.random();
             filesArr.push(file);
             renderPreview(file);
         });
     }

