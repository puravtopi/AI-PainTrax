                        Speaker 0: I have been going for physical therapy three times a week. It's not that helpful as of now.

                        Speaker 1: On a scale of two, how much your low back is staying?

                        Speaker 0: The low back is around nine.

                        Speaker 1: It's

                        Speaker 0: very painful. It's constant.

                        Speaker 1: Is it sharp or dull?

                        Speaker 0: Sharp.

                        Speaker 1: Traveled for weeks.

                        Speaker 0: Yes.

                        Speaker 1: K. And Yeah. Other than the plus? So if there's anything make it feel better or worse, basically?

                        Speaker 0: When I take pain medications or, like, when I go to sleep resting, that helps me out.

                        Speaker 1: K. So I would like you to make physical examination on you. Now I'll put that on the picture of my eyes. We'll get you up. Yes.

                        ZLX now. Very... Alright. So we can do a few more examination. You're looking at your marks.

                        Looks like, yeah, right here, it gets it all four above. That explains the numbness and tingling out and going down the back. The recommendation is to just type of steroid injections for you. Okay? Alright.

                        So the next five three injections are injections are cortisone injections, which are on the nerve. Except treatment is not acute. The regular acute is to show two rejections. Each injections can run zero to one month to three months. And they're pretty straightforward.

                        It's got a journal with a smaller spanning 100,000 people at end. Serious complication. We aren't even ready to do that. So are you going to aspirate blood thinners?

                        Speaker 0: No. Not at present.

                        Speaker 1: So in that case, the risk is probably very good. You have any questions concerning the diabetes line?

                        Speaker 0: Not right now, except for the pain, if I can reduce the pain. Do I to take any other medications as well? Yes.

                        Speaker 1: I can send you some pain medication. Are you having trouble sleeping at night?

                        Speaker 0: Yes.

                        Speaker 1: K. So you wanna pay that medication, I can say it's a personalized cycle. That's okay. So I'm gonna take it early at night. Couple days, we don't have to worry about.

                        Speaker 0: Nothing right now, doc.

                        Speaker 1: So Alright.

                        Speaker 0: Thank you, doc. *@
        </div>

        <!-- State 3: Loading AI -->
        <div id="uiLoading" class="d-none text-center">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted fw-bold">AI is generating transcript...</p>
        </div>
    </div>
</div>

<script>
        // let mediaRecorder;
    let audioTChunks = [];
    let seconds = 0;
    let timerInterval;
    let isTRecording = false;

    // Format current date for the header
    document.getElementById('currentDate').innerText = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

    const btnToggle = document.getElementById('btnToggleRecord');
    const recordIcon = document.getElementById('recordIcon');
    const uiRecording = document.getElementById('uiRecording');
    const fname = document.getElementById('FN').innerText;
    const lname =  document.getElementById('LN').innerText;



    //document.getElementById('patientName').innerText = fname + " " + lname;

    btnToggle.addEventListener('click', async () => {
        if (!isTRecording) {
            startRecording();
        } else {
            stopRecording();
        }
    });

    async function startRecording() {
        // debugger
        // document.getElementById('patientName').innerText = fname + " " + lname;

        alert(fname);

        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioTChunks = [];

        mediaRecorder.ondataavailable = e => audioTChunks.push(e.data);
        mediaRecorder.onstop = processWithWhisper;

        mediaRecorder.start();
        isTRecording = true;

        // UI Updates
        recordIcon.className = "bi bi-pause-fill me-2";
        btnToggle.innerText = "Pause";
        btnToggle.style.backgroundColor = "#ff4d4d";

        uiRecording.style.display="block";

        startTimer();
    }

    function stopRecording() {
        mediaRecorder.stop();
        isTRecording = false;

        // UI Updates
        recordIcon.className = "bi bi-mic-fill me-2";
        btnToggle.innerText = "Resume";
        btnToggle.style.backgroundColor = "#28a745"; // Green for resume

        clearInterval(timerInterval);

        // Show Loading
        document.getElementById('uiRecording').classList.add('d-none');
        document.getElementById('uiLoading').classList.remove('d-none');
    }

    function startTimer() {
        seconds = 0;
        timerInterval = setInterval(() => {
            seconds++;
            document.getElementById('timerDisplay').innerText = seconds + " sec";
        }, 1000);
    }

    function openTab(evt, tabName) {
        // 1. Hide all tab content
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-pane-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }

        // 2. Remove "active" class from all tab links
        tablinks = document.querySelectorAll(".scribe-tabs .nav-link");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].classList.remove("active");
        }

        // 3. Show the current tab, and add an "active" class to the button that opened the tab
        document.getElementById(tabName).style.display = "block";
        evt.currentTarget.classList.add("active");

        if(tabName=="tab-note")
        {
            generateAINote();
        }
    }

    // Function to Copy Specific Sections
    function copySection(elementId) {
        const text = document.getElementById(elementId).innerText;

        navigator.clipboard.writeText(text).then(() => {
            // Visual feedback (Change button text temporarily)
            const btn = document.querySelector(`[onclick="copySection('${elementId}')"]`);
            const originalHTML = btn.innerHTML;

            btn.innerHTML = '<i class="bi bi-check2 text-success"></i> Copied!';
            btn.classList.add('bg-success-subtle');

            setTimeout(() => {
                btn.innerHTML = originalHTML;
                btn.classList.remove('bg-success-subtle');
            }, 2000);
        });
    }

    async function processWithWhisper() {
        const audioBlob = new Blob(audioTChunks, { type: 'audio/wav' });
        const formData = new FormData();
        formData.append("audioFile", audioBlob, "visit_record.wav");

        try {
            const response = await fetch('/IntakeForm/ProcessRecording', { method: 'POST', body: formData });
            const result = await response.json();

            document.getElementById('uiLoading').classList.add('d-none');
            document.getElementById('uiResult').classList.remove('d-none');

            if (result.success) {
                document.getElementById('uiResult').innerText = result.text;
            } else {
                document.getElementById('uiResult').innerHTML = `<span class="text-danger">Error: ${result.error}</span>`;
            }
        } catch (err) {
            console.error("AI processing failed", err);
        }
    }

    async function generateAINote() {
        debugger
        var rawTranscript= document.getElementById('uiResult').innerText;
        var ie_id= $("#hdIEId").val();
        var intake_id= $("#hdId").val();
        var length= document.getElementById('timerDisplay').innerText.split(" ")[0];
        // Show loading spinner in your UI here
        document.getElementById('uiLoading').style.display = 'block';
        var url="@Url.Action("GenerateStructuredReport", "IntakeForm")";
        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ transcript: rawTranscript, intake_id: intake_id, length:length }) // Sending raw transcript string
            });

            const result = await response.json();

            // if (result.success) {
                // Hide loading, show note container
                // document.getElementById('uiLoading').style.display = 'none';
                // document.getElementById('aiNoteResult').classList.remove('d-none');

                // Inject AI content into specific divs
                document.getElementById('contentHistory').innerText = result.history;
                document.getElementById('contentCC').innerText = result.chiefComplaint;
                document.getElementById('uiResult').innerText = result.transcript;

                // Combining Assessment and Plan for the Skriber look
                document.getElementById('contentPlan').innerText =
                    result.assessment + "\n\n" + result.plan;
            // }
        } catch (error) {
            console.error("Error generating note:", error);
        }
    }
</script>