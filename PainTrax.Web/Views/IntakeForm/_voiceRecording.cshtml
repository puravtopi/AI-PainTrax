@model PainTrax.Web.Models.TranscribeData
<style>
    /* Clinical Dashboard Styles */
    .scribe-modal-content {
        border-radius: 12px;
        border: none;
        background-color: #fff;
    }

    .scribe-header {
        padding: 20px 24px;
        border-bottom: 1px solid #f0f0f0;
    }

    .patient-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-right: 10px;
    }

    .meta-info {
        font-size: 0.9rem;
        color: #6c757d;
        display: flex;
        gap: 15px;
        margin-top: 5px;
    }

    /* Tabs Style */
    .scribe-tabs {
        border-bottom: 1px solid #dee2e6;
        padding: 0 24px;
    }

        .scribe-tabs .nav-link {
            color: #6c757d;
            border: none;
            padding: 12px 20px;
            font-weight: 500;
            font-size: 0.95rem;
            position: relative;
            transition: all 0.3s;
        }

            .scribe-tabs .nav-link.active {
                color: #0d6efd;
                background: none;
            }

                .scribe-tabs .nav-link.active::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 100%;
                    height: 3px;
                    background-color: #0d6efd;
                }

    /* Main Workspace */
    .workspace-container {
        background-color: #f9f9f9;
        padding: 30px;
        min-height: 400px;
    }

    .recording-card {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 16px;
        min-height: 350px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    /* Mic Animation */
    .mic-circle {
        width: 60px;
        height: 60px;
        border: 1px solid #ff4d4d;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff4d4d;
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    /* Action Buttons */
    .btn-end-visit {
        background-color: #f8f1eb;
        border: 1px solid #e2d1c3;
        color: #333;
        font-weight: 500;
    }

    .btn-pause {
        background-color: #ff4d4d;
        color: white;
        font-weight: 500;
        border: none;
    }

    .btn-copy {
        position: absolute;
        top: 15px;
        right: 15px;
        color: #6c757d;
        border: 1px solid #dee2e6;
        font-size: 0.85rem;
    }

    /* Transcript Area */
    .transcript-text {
        padding: 40px;
        font-size: 1.1rem;
        line-height: 1.8;
        color: #2c3e50;
        text-align: left;
        width: 100%;
    }
</style>
<style>
    .note-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
    }

    .note-section {
        position: relative;
        margin-bottom: 25px;
        padding-right: 40px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .section-title {
        font-weight: 700;
        color: #2c5282; /* Professional Blue */
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

    .section-content {
        font-size: 1.05rem;
        line-height: 1.6;
        color: #4a5568;
        white-space: pre-line; /* Preserves AI line breaks */
    }

    .copy-section-btn {
        position: absolute;
        right: 0;
        top: 0;
        background: transparent;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        color: #718096;
        transition: all 0.2s;
    }

        .copy-section-btn:hover {
            background: #edf2f7;
            color: #2d3748;
        }

        .copy-section-btn i {
            font-size: 1rem;
        }
</style>


<!-- 1. Top Header -->
<div class="scribe-header d-flex justify-content-between align-items-center">
    <div>
        <div class="d-flex align-items-center">
            <span class="patient-name" id="patientName">@Model.PatientName</span>
            <i class="bi bi-pencil text-muted small me-2" style="cursor:pointer"></i>
            <i class="bi bi-eye text-muted small" style="cursor:pointer"></i>
        </div>
        <div class="meta-info">
            <span><i class="bi bi-calendar3 me-1"></i> <span>@Model.DOE</span></span>
            <span><i class="bi bi-clock me-1"></i> <span id="timerDisplay">@Model.Length sec</span></span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-end-visit px-4 rounded-3"><i class="bi bi-arrow-counterclockwise me-2"></i>End Visit</button>
        <button id="btnToggleRecord" class="btn btn-pause px-4 rounded-3"><i id="recordIcon" class="bi bi-pause-fill me-2"></i>Start Recording</button>
    </div>
</div>

<!-- 2. Navigation Tabs -->
<ul class="nav scribe-tabs">
    <li class="nav-item d-none"><a class="nav-link" href="javascript:void(0)" onclick="openTab(event, 'tab-context')"><i class="bi bi-justify-left me-2"></i>Context</a></li>
    <li class="nav-item"><a class="nav-link active" href="javascript:void(0)" onclick="openTab(event, 'tab-transcript')"><i class="bi bi-reception-4 me-2"></i>Transcript</a></li>
    <li class="nav-item"><a class="nav-link" href="javascript:void(0)" onclick="openTab(event, 'tab-note')"><i class="bi bi-pencil-square me-2"></i>Note</a></li>
    <li class="nav-item d-none"><a class="nav-link" href="javascript:void(0)" onclick="openTab(event, 'tab-tasks')">Tasks <span class="badge bg-light text-primary rounded-pill">0</span></a></li>
    <li class="nav-item d-none"><a class="nav-link" href="javascript:void(0)" onclick="openTab(event, 'tab-billing')">Billing codes</a></li>
</ul>

<!-- 3. Workspace Area -->
<div class="workspace-container">

    <div id="tab-note" class="tab-pane-content" style="display:none">
        <div class="mb-3"><span class="badge bg-light text-muted border">H&P</span></div>

        <!-- 1. History Section -->
        <div class="note-section">
            <div class="section-header">
                <span class="section-title">History of Present Illness</span>
                <button class="copy-section-btn" onclick="copySection('contentHistory')">
                    <i class="bi bi-copy"></i> Copy section
                </button>
            </div>
            <div id="contentHistory" class="section-content"></div>
        </div>

        <!-- 2. Chief Complaint Section -->
        <div class="note-section">
            <div class="section-header">
                <span class="section-title">Chief Complaint</span>
                <button class="copy-section-btn" onclick="copySection('contentCC')">
                    <i class="bi bi-copy"></i> Copy section
                </button>
            </div>
            <div id="contentCC" class="section-content"></div>
        </div>

        <!-- 3. Assessment & Plan Section -->
        <div class="note-section">
            <div class="section-header">
                <span class="section-title">Assessment & Plan</span>
                <button class="copy-section-btn" onclick="copySection('contentPlan')">
                    <i class="bi bi-copy"></i> Copy section
                </button>
            </div>
            <div id="contentPlan" class="section-content"></div>
        </div>
    </div>

    <div class="recording-card tab-pane-content" id="tab-transcript">
        <button class="btn btn-copy bg-white"><i class="bi bi-copy me-2"></i>Copy transcript</button>

        <!-- State 1: Recording -->
        <div id="uiRecording" style="display:none">
            <div class="mic-circle">
                <i class="bi bi-mic-fill"></i>
            </div>
            <h4 class="fw-bold mb-1">Recording in Progress</h4>
            <p class="text-muted">Your transcript will appear here once you click 'Pause'.</p>
        </div>

        <!-- State 2: Result (Hidden by default) -->
        <div id="uiResult" class="transcript-text">
            @Html.Raw(Model.Transcript)
            @*  Speaker 0: Hi. Good morning,

